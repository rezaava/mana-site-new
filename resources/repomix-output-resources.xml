    text-align: center;
  }
  .chat-fab {
    width: 50px;
    height: 50px;
    font-size: 1.1rem;
    bottom: 20px;
    right: 18px;
  }
  .to-top {
    width: 42px;
    height: 42px;
    bottom: 20px;
    left: 18px;
  }
}
