  .overview .row {
    flex-direction: column-reverse;
  }
  .gal-grid {
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .svc-grid {
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pinfo-grid {
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .sim-grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .pn-grid {
    grid-template-columns: 1fr;
  }
  .cta-banner {
    padding: 50px 26px;
    border-radius: 28px;
  }
}
@media (max-width: 576px) {
  .container-x {
    padding: 0 16px;
  }
  .section-title {
    font-size: 1.6rem;
  }
  .case-hero h1 {
    font-size: 1.8rem;
  }
  .case-meta-chip {
    font-size: 0.78rem;
    padding: 8px 13px;
  }
  .gal-grid {
    grid-template-columns: 1fr;
  }
  .svc-grid {
    grid-template-columns: 1fr;
  }
  .pinfo-grid {
    grid-template-columns: 1fr 1fr;
  }
  .tech-pill {
    padding: 12px 18px;
    font-size: 0.85rem;
  }
  .stat-item h3 {
    font-size: 1.4rem;
  }
  .quote-card {
    flex-direction: column;
  }
  .footer-island {
    padding: 26px 16px 0;
  }
  .footer-3col {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 34px;
  }
  .footer-col h5::after {
    right: 50%;
    transform: translateX(50%);
  }
  .footer-col ul li a {
    justify-content: center;
  }
  .footer-center {
    order: -1;
  }
  .footer-newsletter {
    flex-direction: column;
    text-align: center;
    padding: 18px;
  }
  .footer-newsletter .fn-text {
