  }
  .stat-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .overview,
  .gallery,
  .features,
  .techstack,
  .pinfo,
  .similar {
    padding: 80px 0;
  }
  .final-cta {
    padding: 10px 0 80px;
  }
  .pn-nav {
    padding: 0 0 80px;
