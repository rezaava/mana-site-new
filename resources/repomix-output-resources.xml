      }
      .comment-item .cbody p {
        margin: 8px 0 0;
        color: var(--text-dim);
        font-size: 0.9rem;
        line-height: 1.8;
      }
      .comment-item .cbody .reply-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 10px;
        font-size: 0.8rem;
        color: var(--accent-2);
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
      }
      .comment-item .cbody .reply-btn:hover {
        gap: 10px;
      }

      /* ===== فرم نظر ===== */
      .comment-form {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 32px;
        margin-top: 40px;
      }
      .comment-form textarea {
        width: 100%;
        background: var(--bg-soft);
        border: 1px solid var(--line);
