        background: color-mix(in srgb, var(--accent-2) 15%, transparent);
        padding: 3px 14px;
        border-radius: 99px;
        border: 1px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
        margin-bottom: 8px;
      }

      .highlight-box.premium-box .premium-box-content p {
        margin: 0;
        color: var(--text);
        font-size: 1rem;
        line-height: 1.9;
        font-weight: 500;
      }

      .highlight-box.premium-box .premium-box-content p strong {
        color: var(--accent-2);
        font-weight: 700;
      }

      /* تصویر */
      .highlight-box.premium-box .premium-box-image {
        width: 70px;
        height: 70px;
        border-radius: 16px;
        overflow: hidden;
        flex: none;
        border: 2px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
        box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.3);
        transition: all 0.5s var(--ease);
      }

      .highlight-box.premium-box:hover .premium-box-image {
        transform: rotate(-6deg) scale(1.05);
        border-color: var(--accent-2);
      }

      .highlight-box.premium-box .premium-box-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* دکوریشن پس‌زمینه */
      .highlight-box.premium-box::before {
        content: "";
        position: absolute;
        top: -60px;
        right: -60px;
        width: 200px;
        height: 200px;
        background: radial-gradient(
          circle,
          color-mix(in srgb, var(--brand) 20%, transparent),
          transparent 70%
        );
        border-radius: 50%;
        pointer-events: none;
      }

      .highlight-box.premium-box::after {
        content: "";
        position: absolute;
        bottom: -80px;
        left: -40px;
        width: 160px;
        height: 160px;
        background: radial-gradient(
          circle,
          color-mix(in srgb, var(--accent-2) 15%, transparent),
          transparent 70%
        );
        border-radius: 50%;
        pointer-events: none;
      }

      /* ===== تگ‌ها ===== */
      .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 40px 0 30px;
        padding-top: 30px;
        border-top: 1px solid var(--line);
        clear: both;
      }
      .post-tags a {
        padding: 8px 18px;
        border-radius: 99px;
        background: var(--surface-2);
        border: 1px solid var(--line);
        font-size: 0.8rem;
        color: var(--text-dim);
        transition: all 0.3s var(--ease);
        position: relative;
        overflow: hidden;
      }
      .post-tags a::before {
        content: "#";
        opacity: 0.5;
        margin-left: 4px;
      }
      .post-tags a:hover {
        background: var(--accent-2);
        color: var(--oncta);
        border-color: transparent;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--accent-2) 60%, transparent);
      }

      /* ===== اشتراک‌گذاری ===== */
      .share-bar {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        margin: 30px 0;
        flex-wrap: wrap;
        clear: both;
      }
      .share-bar span {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--text-dim);
      }
      .share-bar a {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-dim);
        transition: all 0.35s var(--ease);
        font-size: 0.95rem;
      }
      .share-bar a:hover {
        transform: translateY(-4px) scale(1.05);
        border-color: transparent;
      }
      .share-bar a.telegram:hover {
        background: #0088cc;
        color: #fff;
      }
      .share-bar a.twitter:hover {
        background: #000;
        color: #fff;
      }
      .share-bar a.linkedin:hover {
        background: #0a66c2;
        color: #fff;
      }
      .share-bar a.whatsapp:hover {
        background: #25d366;
        color: #fff;
      }

      /* ===== نظرات ===== */
      .comments-section {
        padding: 50px 0 0;
      }
      .comments-section .section-title-sm {
        font-weight: 800;
        font-size: 1.4rem;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .comments-section .section-title-sm i {
        color: var(--accent-2);
      }
      .comment-item {
        display: flex;
        gap: 18px;
        padding: 24px 0;
        border-bottom: 1px solid var(--line);
        transition: 0.3s;
      }
      .comment-item:last-child {
        border-bottom: none;
      }
      .comment-item:hover {
        padding-right: 12px;
      }
      .comment-item .cav {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--oncta);
        font-size: 0.95rem;
        overflow: hidden;
      }
      .comment-item .cav img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .comment-item .cbody h6 {
        font-weight: 700;
        margin: 0 0 4px;
        font-size: 0.95rem;
      }
      .comment-item .cbody .date {
        font-size: 0.74rem;
        color: var(--text-dimmer);
      }
      .comment-item .cbody p {
        margin: 8px 0 0;
        color: var(--text-dim);
        font-size: 0.9rem;
        line-height: 1.8;
      }
      .comment-item .cbody .reply-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 10px;
        font-size: 0.8rem;
        color: var(--accent-2);
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
      }
      .comment-item .cbody .reply-btn:hover {
        gap: 10px;
      }

      /* ===== فرم نظر ===== */
      .comment-form {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 32px;
        margin-top: 40px;
      }
      .comment-form textarea {
        width: 100%;
        background: var(--bg-soft);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 16px 20px;
        color: var(--text);
        font-family: inherit;
        font-size: 0.92rem;
        min-height: 110px;
        resize: vertical;
        transition: 0.3s;
      }
      .comment-form textarea:focus {
        outline: none;
        border-color: var(--accent-2);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-2) 15%, transparent);
      }
      .comment-form input {
        width: 100%;
        background: var(--bg-soft);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 14px 18px;
        color: var(--text);
        font-family: inherit;
        font-size: 0.92rem;
        margin-bottom: 14px;
        transition: 0.3s;
      }
      .comment-form input:focus {
        outline: none;
        border-color: var(--accent-2);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-2) 15%, transparent);
      }
      .comment-form .btn-flow {
        border: none;
        width: 100%;
        justify-content: center;
      }

      /* ===== سایدبار ===== */
      .sidebar-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 28px;
        margin-bottom: 28px;
        transition: all 0.4s var(--ease);
        box-shadow: var(--shadow-strong);
      }
      .sidebar-card:hover {
        border-color: color-mix(in srgb, var(--accent-2) 30%, transparent);
        transform: translateY(-4px);
      }
      .sidebar-card h5 {
        font-weight: 700;
        margin-bottom: 20px;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .sidebar-card h5 i {
        color: var(--accent-2);
      }
      .sidebar-card h5::after {
        content: "";
        flex: 1;
        height: 2px;
        background: linear-gradient(to left, var(--line), transparent);
        margin-right: 12px;
      }

      .related-item {
        display: flex;
        gap: 14px;
        padding-bottom: 18px;
        margin-bottom: 18px;
        border-bottom: 1px solid var(--line);
        transition: 0.3s;
        cursor: pointer;
      }
      .related-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
      }
      .related-item:hover {
        padding-right: 8px;
      }
      .related-item .thumb {
        width: 70px;
        height: 70px;
        border-radius: 14px;
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.8);
        transition: 0.3s;
        overflow: hidden;
      }
      .related-item .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .related-item:hover .thumb {
        transform: scale(1.05);
      }
      .related-item .thumb.t1 {
        background: linear-gradient(150deg, #1d2a6b, #0b1030);
      }
      .related-item .thumb.t2 {
        background: linear-gradient(150deg, #0d5c52, #07211d);
      }
      .related-item .thumb.t3 {
        background: linear-gradient(150deg, #6b2a4a, #2b0f1e);
      }
      .related-item .rinfo h6 {
        font-weight: 700;
        font-size: 0.88rem;
        margin: 0 0 4px;
        line-height: 1.5;
      }
      .related-item .rinfo span {
        font-size: 0.74rem;
        color: var(--text-dimmer);
      }

      .sidebar-cat-list a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid var(--line);
        color: var(--text-dim);
        font-size: 0.87rem;
        transition: all 0.3s var(--ease);
      }
      .sidebar-cat-list a:last-child {
        border-bottom: none;
      }
      .sidebar-cat-list a:hover {
        color: var(--accent-2);
        padding-right: 8px;
      }
      .sidebar-cat-list a span {
        background: var(--surface-2);
        padding: 2px 10px;
        border-radius: 99px;
        font-size: 0.7rem;
        color: var(--text-dimmer);
        transition: 0.3s;
      }
      .sidebar-cat-list a:hover span {
        background: var(--accent-2);
        color: var(--oncta);
      }

      /* ===== ریسپانسیو ===== */
      @media (max-width: 991px) {
        .single-hero {
