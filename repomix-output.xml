    border-radius: 12px;
}

.action-item:hover i {
    color: #1e6f9f;
    background: #eef5fc;
    transform: scale(1.1);
}

.action-tooltip {
    position: absolute;
    bottom: -32px;
    left: 50%;
    transform: translateX(-50%) translateY(5px);
    background: #1f3e4b;
    color: white;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.7rem;
    font-weight: 500;
