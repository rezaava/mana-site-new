      .stat-card .stat-icon.purple {
        background: linear-gradient(135deg, #8b5cf6, #a78bfa);
      }
      .stat-card h3 {
        font-weight: 800;
        font-size: 1.6rem;
        margin: 0;
      }
      .stat-card span {
        color: var(--text-dim);
        font-size: 0.82rem;
      }
      .stat-card .change {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 2px 10px;
        border-radius: 99px;
        margin-top: 6px;
