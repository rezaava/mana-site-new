      }
      .comment-item .cbody .time {
        font-size: 0.68rem;
        color: var(--text-dimmer);
      }

      /* ===== GRAPHIC / MOTION POLISH (رنگ‌ها دست‌نخورده) ===== */
      @keyframes fadeUpIn {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
