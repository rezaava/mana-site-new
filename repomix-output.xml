  }
  .stat-item {
    border-left: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 14px;
    margin-bottom: 14px;
  }
  .stat-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .services {
    padding: 90px 0 80px;
  }
  .why,
  .folio,
  .team,
  .testi,
  .faqc,
  .blog {
    padding: 80px 0;
  }
  .services-head {
    margin-bottom: 44px;
  }
  .svc-grid {
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .svc-card {
    padding: 30px 22px 26px;
  }
  .svc-card:nth-child(2),
  .svc-card:nth-child(5) {
    transform: none;
  }
  .svc-card:nth-child(2):hover,
  .svc-card:nth-child(5):hover {
