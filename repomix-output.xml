      .sidebar .user-card .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand), var(--accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--oncta);
        font-size: 0.9rem;
        flex: none;
        overflow: hidden;
      }
      .sidebar .user-card .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .sidebar .user-card .info h6 {
        font-weight: 700;
        margin: 0;
        font-size: 0.88rem;
      }
      .sidebar .user-card .info span {
        font-size: 0.74rem;
        color: var(--text-dimmer);
      }

      /* ===== MAIN CONTENT ===== */
      .main-content {
        flex: 1;
        margin-right: var(--sidebar-width);
        padding: 20px 28px 40px;
        transition: margin 0.4s var(--ease);
        min-height: 100vh;
      }
      .main-content.expanded {
        margin-right: 20px;
      }

      /* ===== TOP BAR ===== */
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0 20px;
        border-bottom: 1px solid var(--line);
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
      }
      .topbar .left {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .topbar .left .toggle-btn {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--text);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.3s;
        font-size: 1rem;
      }
      .topbar .left .toggle-btn:hover {
        background: var(--card-hover);
        border-color: var(--accent-2);
      }
      .topbar .left h4 {
        font-weight: 700;
        margin: 0;
        font-size: 1.15rem;
      }
      .topbar .right {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .topbar .right .theme-switch {
        width: 50px;
        height: 28px;
        border-radius: 99px;
        border: 1px solid var(--line);
        background: var(--surface-2);
        position: relative;
        cursor: pointer;
        flex: none;
      }
      .topbar .right .theme-switch .knob {
        position: absolute;
        top: 3px;
        right: 3px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand), var(--accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--oncta);
        font-size: 0.6rem;
        transition: transform 0.4s var(--ease);
      }
      [data-theme="light"] .topbar .right .theme-switch .knob {
        transform: translateX(-20px);
      }
      .topbar .right .notif-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--text-dim);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.3s;
        position: relative;
      }
      .topbar .right .notif-btn:hover {
        border-color: var(--accent-2);
        color: var(--text);
      }
      .topbar .right .notif-btn .dot {
        position: absolute;
        top: 9px;
        left: 9px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
        border: 2px solid var(--surface);
      }

      /* ===== STATS CARDS ===== */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 24px;
      }
      .stat-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 20px 22px;
        transition: all 0.4s var(--ease);
        box-shadow: var(--shadow-strong);
        position: relative;
        overflow: hidden;
      }
      .stat-card:hover {
        transform: translateY(-5px);
        border-color: color-mix(in srgb, var(--accent-2) 40%, transparent);
      }
      .stat-card .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 12px;
        color: var(--oncta);
      }
      .stat-card .stat-icon.blue {
        background: linear-gradient(135deg, var(--brand), #4a8afb);
      }
      .stat-card .stat-icon.green {
        background: linear-gradient(135deg, var(--accent-2), #2ad4c0);
      }
      .stat-card .stat-icon.yellow {
        background: linear-gradient(135deg, var(--accent), #ffcc44);
      }
      .stat-card .stat-icon.purple {
        background: linear-gradient(135deg, #8b5cf6, #a78bfa);
      }
      .stat-card h3 {
        font-weight: 800;
        font-size: 1.6rem;
        margin: 0;
      }
      .stat-card span {
        color: var(--text-dim);
        font-size: 0.82rem;
      }
      .stat-card .change {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 2px 10px;
        border-radius: 99px;
        margin-top: 6px;
      }
      .stat-card .change.up {
        color: var(--accent-2);
        background: color-mix(in srgb, var(--accent-2) 15%, transparent);
      }
      .stat-card .change.down {
        color: #ef4444;
        background: color-mix(in srgb, #ef4444 15%, transparent);
      }
      .stat-card .stat-bg {
        position: absolute;
        bottom: -25px;
        left: -15px;
        font-size: 4.5rem;
        opacity: 0.04;
        pointer-events: none;
      }

      /* ===== CHARTS ROW ===== */
      .charts-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
      }
      .chart-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 22px;
        box-shadow: var(--shadow-strong);
        transition: all 0.4s var(--ease);
      }
      .chart-card:hover {
        border-color: color-mix(in srgb, var(--accent-2) 30%, transparent);
      }
      .chart-card .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 8px;
      }
      .chart-card .card-header h6 {
        font-weight: 700;
        margin: 0;
        font-size: 0.9rem;
      }
      .chart-card .card-header .filter-btns {
        display: flex;
        gap: 5px;
      }
      .chart-card .card-header .filter-btns button {
        padding: 3px 12px;
        border-radius: 99px;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--text-dim);
        font-size: 0.68rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        font-family: inherit;
      }
      .chart-card .card-header .filter-btns button:hover,
      .chart-card .card-header .filter-btns button.active {
        background: var(--brand);
        color: var(--oncta);
        border-color: var(--brand);
      }
      .chart-card canvas {
        width: 100% !important;
        max-height: 230px;
      }

      /* ===== BOTTOM ROW ===== */
      .bottom-row {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 20px;
        margin-bottom: 24px;
      }
      .visitor-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 22px;
        box-shadow: var(--shadow-strong);
        transition: all 0.4s var(--ease);
      }
      .visitor-card:hover {
        border-color: color-mix(in srgb, var(--accent-2) 30%, transparent);
      }
      .visitor-card h6 {
        font-weight: 700;
        margin-bottom: 14px;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .visitor-card h6 i {
        color: var(--accent-2);
      }

      .visitor-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid var(--line);
      }
      .visitor-item:last-child {
        border-bottom: none;
      }
      .visitor-item .label {
        color: var(--text-dim);
        font-size: 0.84rem;
        min-width: 70px;
      }
      .visitor-item .value {
        font-weight: 700;
        font-size: 0.88rem;
        min-width: 60px;
        text-align: left;
      }
      .visitor-item .bar-track {
        flex: 1;
        height: 5px;
        background: var(--surface-2);
        border-radius: 99px;
        margin: 0 12px;
        overflow: hidden;
      }
      .visitor-item .bar-track .bar-fill {
        height: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg, var(--brand), var(--accent-2));
        transition: width 1s var(--ease);
      }
      .visitor-item .bar-track .bar-fill.orange {
        background: linear-gradient(90deg, var(--accent), #ffcc44);
      }
      .visitor-item .bar-track .bar-fill.green {
        background: linear-gradient(90deg, var(--accent-2), #4ade80);
      }
      .visitor-item .bar-track .bar-fill.purple {
        background: linear-gradient(90deg, #8b5cf6, #a78bfa);
      }
      .visitor-item .bar-track .bar-fill.pink {
        background: linear-gradient(90deg, #ec4899, #f472b6);
      }

      /* ===== COMMENTS ===== */
      .comments-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 22px;
        box-shadow: var(--shadow-strong);
        transition: all 0.4s var(--ease);
        max-height: 380px;
        overflow-y: auto;
      }
      .comments-card:hover {
        border-color: color-mix(in srgb, var(--accent-2) 30%, transparent);
      }
      .comments-card h6 {
        font-weight: 700;
        margin-bottom: 14px;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .comments-card h6 i {
        color: var(--accent-2);
      }

      .comment-item {
        display: flex;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--line);
        transition: 0.3s;
        cursor: pointer;
      }
      .comment-item:last-child {
        border-bottom: none;
      }
      .comment-item:hover {
        padding-right: 6px;
      }
      .comment-item .cav {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--oncta);
        font-size: 0.8rem;
        overflow: hidden;
      }
      .comment-item .cav img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .comment-item .cbody h6 {
        font-weight: 700;
        margin: 0 0 2px;
        font-size: 0.84rem;
      }
      .comment-item .cbody p {
        margin: 0;
        color: var(--text-dim);
        font-size: 0.8rem;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .comment-item .cbody .time {
        font-size: 0.68rem;
        color: var(--text-dimmer);
      }

      /* ===== GRAPHIC / MOTION POLISH (رنگ‌ها دست‌نخورده) ===== */
      @keyframes fadeUpIn {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .stat-card,
      .chart-card,
      .visitor-card,
      .comments-card {
        animation: fadeUpIn 0.5s var(--ease) both;
      }
      .stats-grid .stat-card:nth-child(1) { animation-delay: 0.02s; }
      .stats-grid .stat-card:nth-child(2) { animation-delay: 0.08s; }
      .stats-grid .stat-card:nth-child(3) { animation-delay: 0.14s; }
      .stats-grid .stat-card:nth-child(4) { animation-delay: 0.2s; }
      .charts-row .chart-card:nth-child(1) { animation-delay: 0.1s; }
      .charts-row .chart-card:nth-child(2) { animation-delay: 0.16s; }
      .bottom-row .visitor-card { animation-delay: 0.1s; }
      .bottom-row .comments-card { animation-delay: 0.16s; }

      .stat-card .stat-icon {
        transition: transform 0.4s var(--ease);
      }
      .stat-card:hover .stat-icon {
        transform: scale(1.1) rotate(-6deg);
      }

      .sidebar .nav-item::before {
        content: "";
        position: absolute;
        top: 50%;
        right: 0;
        transform: translateY(-50%);
        width: 3px;
        height: 0;
        border-radius: 99px;
        background: var(--accent-2);
        transition: height 0.3s var(--ease);
      }
      .sidebar .nav-item:hover::before {
        height: 55%;
      }
      .sidebar .nav-item.active::before {
        height: 0;
      }

      #pageContent {
        animation: fadeUpIn 0.35s var(--ease) both;
      }

      /* ===== RESPONSIVE ===== */
      @media (max-width: 1200px) {
        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .charts-row {
          grid-template-columns: 1fr;
        }
        .bottom-row {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 991px) {
        .sidebar {
          transform: translateX(calc(var(--sidebar-width) + 20px));
        }
        .sidebar.open {
          transform: translateX(0);
        }
        .main-content {
          margin-right: 16px;
          padding: 16px;
        }
        .sidebar-overlay {
          display: none;
          position: fixed;
          inset: 0;
          background: rgba(0, 0, 0, 0.5);
          z-index: 1040;
          backdrop-filter: blur(4px);
        }
        .sidebar-overlay.show {
          display: block;
        }
      }

      @media (max-width: 576px) {
        .stats-grid {
          grid-template-columns: 1fr;
        }
        .main-content {
          padding: 12px;
          margin-right: 0;
        }
        .topbar .left h4 {
          font-size: 0.95rem;
        }
        .stat-card h3 {
          font-size: 1.3rem;
        }
        .stat-card {
          padding: 16px 18px;
        }
        .chart-card {
          padding: 14px;
        }
        .visitor-card,
        .comments-card {
          padding: 14px;
        }
        .topbar {
          padding: 10px 0 14px;
        }
        .visitor-item .label {
          font-size: 0.78rem;
          min-width: 50px;
        }
        .visitor-item .value {
          font-size: 0.8rem;
          min-width: 50px;
        }
        .sidebar {
          width: 280px;
          padding: 16px 12px;
        }
        .sidebar .brand {
          font-size: 1rem;
          padding: 0 8px 16px;
        }
        .sidebar .nav-item {
          padding: 10px 14px;
          font-size: 0.84rem;
        }
        .sidebar .sub-menu .nav-item {
          padding: 7px 14px;
          font-size: 0.78rem;
        }
        .sidebar .user-card {
          padding: 12px 14px;
        }
      }

      @media (max-width: 400px) {
        .topbar .left .toggle-btn {
          width: 36px;
          height: 36px;
          font-size: 0.85rem;
        }
        .topbar .right .notif-btn {
          width: 36px;
          height: 36px;
          font-size: 0.85rem;
        }
        .topbar .right .theme-switch {
          width: 44px;
          height: 26px;
        }
        .topbar .right .theme-switch .knob {
          width: 18px;
          height: 18px;
          font-size: 0.5rem;
          top: 2px;
          right: 2px;
        }
        [data-theme="light"] .topbar .right .theme-switch .knob {
          transform: translateX(-18px);
        }
      }
