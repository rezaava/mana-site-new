  );
}
.cta-banner::before {
  content: "";
  position: absolute;
  width: 420px;
  height: 420px;
  background: radial-gradient(
    circle,
    rgba(255, 255, 255, 0.16),
    transparent 70%
  );
  top: -160px;
  right: -100px;
}
.cta-banner::after {
  content: "";
  position: absolute;
  width: 340px;
  height: 340px;
