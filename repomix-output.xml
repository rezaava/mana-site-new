/* ===== اضافات مخصوص صفحه تک پست ===== */
      .single-hero {
        padding: 170px 0 40px;
        position: relative;
        overflow: hidden;
      }
      [data-theme="dark"] .single-hero {
        background: radial-gradient(
            60% 55% at 85% 10%,
            rgba(47, 125, 251, 0.24),
            transparent 60%
          ),
          radial-gradient(
            50% 45% at 5% 90%,
            rgba(23, 195, 178, 0.13),
            transparent 60%
          ),
          var(--bg);
      }
      [data-theme="light"] .single-hero {
        background: radial-gradient(
            60% 55% at 85% 10%,
            rgba(3, 63, 136, 0.1),
            transparent 60%
          ),
          radial-gradient(
            50% 45% at 5% 90%,
            rgba(13, 158, 145, 0.1),
            transparent 60%
          ),
          var(--bg);
      }

      .single-hero::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 120px;
        background: linear-gradient(to top, var(--bg), transparent);
        pointer-events: none;
        z-index: 1;
      }

      .single-hero h1 {
        font-size: clamp(2rem, 4.2vw, 3.2rem);
        font-weight: 800;
        line-height: 1.3;
        margin-bottom: 20px;
        position: relative;
        z-index: 2;
      }
      .single-hero .section-sub {
        position: relative;
        z-index: 2;
      }

      /* ===== پست متا ===== */
      .post-meta-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px 24px;
        margin: 16px 0 24px;
        color: var(--text-dim);
        font-size: 0.9rem;
        position: relative;
        z-index: 2;
      }
      .post-meta-top span {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .post-meta-top .cat-tag {
        background: color-mix(in srgb, var(--accent-2) 18%, transparent);
        color: var(--accent-2);
        padding: 4px 16px;
        border-radius: 99px;
        font-weight: 700;
        font-size: 0.8rem;
        border: 1px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
        transition: 0.3s;
      }
      .post-meta-top .cat-tag:hover {
        background: var(--accent-2);
        color: var(--oncta);
        border-color: transparent;
      }

      /* ===== باکس نویسنده ===== */
      .single-author-box {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 24px 28px;
        border-radius: 20px;
        background: var(--surface);
        border: 1px solid var(--line);
        margin: 30px 0 40px;
        position: relative;
        z-index: 2;
        transition: all 0.4s var(--ease);
        box-shadow: var(--shadow-strong);
      }
      .single-author-box:hover {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--accent-2) 40%, transparent);
      }
      .single-author-box .avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand), var(--accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--oncta);
        font-size: 1.4rem;
        flex: none;
        position: relative;
        overflow: hidden;
      }
      .single-author-box .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .single-author-box .avatar::after {
        content: "";
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 2px solid color-mix(in srgb, var(--accent-2) 40%, transparent);
        animation: avatarPulse 3s ease-in-out infinite;
      }
      @keyframes avatarPulse {
        0%,
        100% {
          transform: scale(1);
          opacity: 0.4;
        }
        50% {
          transform: scale(1.1);
          opacity: 1;
        }
      }
      .single-author-box .info h5 {
        font-weight: 700;
        margin: 0 0 4px;
        font-size: 1.05rem;
      }
      .single-author-box .info p {
        color: var(--text-dim);
        margin: 0;
        font-size: 0.85rem;
        line-height: 1.6;
      }
      .single-author-box .social-links {
        display: flex;
        gap: 10px;
        margin-right: auto;
      }
      .single-author-box .social-links a {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-dim);
        transition: 0.3s;
      }
      .single-author-box .social-links a:hover {
