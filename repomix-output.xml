<file path="app/Http/Controllers/SiteController.php">
<?php

namespace App\Http\Controllers;

use App\Models\Blogs;
use App\Models\Projects;
use App\Models\Services;
use App\Models\Team;
use App\Models\Questions;
use App\Models\Comments;
use App\Models\Images;
use App\Models\Features;
use App\Models\SiteText;
use Illuminate\Http\Request;

class SiteController extends Controller
{
    public function index()
{
    $services = Services::orderBy('number')->get();
    $projects = Projects::orderBy('number')->limit(6)->get();
    $team = Team::orderBy('number')->get();
    $questions = Questions::orderBy('number')->get();
    $blogs = Blogs::orderBy('number')->limit(4)->get();
    
    // تغییر نام از $testimonials به $comments
    $comments = Comments::where('is_approved', true)->limit(4)->get();

    $stats = [
        'projects_count' => Projects::count(),
        'customers_count' => 50,
        'support_hours' => 24,
    ];


    return view('index', compact('services', 'projects', 'team', 'questions', 'blogs', 'comments', 'stats'));
}

    public function blog()
    {
        $blogs = Blogs::orderBy('number')->paginate(9);
        return view('blog', compact('blogs'));
    }

    public function singleBlog($id)
    {
        $blog = Blogs::findOrFail($id);
        $relatedBlogs = Blogs::where('id', '!=', $id)->orderBy('number')->limit(3)->get();
        $comments = Comments::where('is_approved', true)->latest()->get();
        return view('singleblog', compact('blog', 'relatedBlogs', 'comments'));
    }

    public function project($id)
    {
        $project = Projects::findOrFail($id);
        $images = Images::where('type', 1)->where('sub-id', $id)->get();
        $features = Features::where('type', 1)->where('sub-id', $id)->get();
        return view('project', compact('project', 'images', 'features'));
    }
}
