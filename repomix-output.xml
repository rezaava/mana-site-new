        z-index: 2;
      }
      .single-hero .section-sub {
        position: relative;
        z-index: 2;
      }

      /* ===== پست متا ===== */
      .post-meta-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px 24px;
        margin: 16px 0 24px;
        color: var(--text-dim);
        font-size: 0.9rem;
        position: relative;
        z-index: 2;
      }
      .post-meta-top span {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .post-meta-top .cat-tag {
        background: color-mix(in srgb, var(--accent-2) 18%, transparent);
        color: var(--accent-2);
        padding: 4px 16px;
        border-radius: 99px;
        font-weight: 700;
        font-size: 0.8rem;
        border: 1px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
        transition: 0.3s;
      }
      .post-meta-top .cat-tag:hover {
        background: var(--accent-2);
        color: var(--oncta);
        border-color: transparent;
      }

      /* ===== باکس نویسنده ===== */
      .single-author-box {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 24px 28px;
        border-radius: 20px;
        background: var(--surface);
        border: 1px solid var(--line);
        margin: 30px 0 40px;
        position: relative;
        z-index: 2;
        transition: all 0.4s var(--ease);
        box-shadow: var(--shadow-strong);
      }
      .single-author-box:hover {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--accent-2) 40%, transparent);
      }
      .single-author-box .avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand), var(--accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--oncta);
        font-size: 1.4rem;
        flex: none;
        position: relative;
        overflow: hidden;
      }
      .single-author-box .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .single-author-box .avatar::after {
        content: "";
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 2px solid color-mix(in srgb, var(--accent-2) 40%, transparent);
        animation: avatarPulse 3s ease-in-out infinite;
      }
      @keyframes avatarPulse {
        0%,
        100% {
          transform: scale(1);
          opacity: 0.4;
        }
        50% {
          transform: scale(1.1);
          opacity: 1;
        }
      }
      .single-author-box .info h5 {
        font-weight: 700;
        margin: 0 0 4px;
        font-size: 1.05rem;
      }
      .single-author-box .info p {
        color: var(--text-dim);
        margin: 0;
        font-size: 0.85rem;
        line-height: 1.6;
      }
      .single-author-box .social-links {
        display: flex;
        gap: 10px;
        margin-right: auto;
      }
      .single-author-box .social-links a {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-dim);
        transition: 0.3s;
      }
      .single-author-box .social-links a:hover {
        background: linear-gradient(135deg, var(--brand), var(--accent-2));
        color: var(--oncta);
        border-color: transparent;
        transform: translateY(-3px);
      }

      /* ===== محتوای مقاله ===== */
      .post-body {
        font-size: 1.02rem;
        line-height: 2.1;
        color: var(--text);
      }
      .post-body .lead {
        font-size: 1.15rem;
        color: var(--text);
        font-weight: 500;
        border-right: 4px solid var(--accent-2);
        padding-right: 20px;
        margin-bottom: 30px;
      }
      .post-body h2 {
        font-weight: 800;
        font-size: 1.6rem;
        margin: 44px 0 18px;
        position: relative;
        padding-right: 20px;
      }
      .post-body h2::before {
        content: "";
        position: absolute;
        right: 0;
        top: 8px;
        bottom: 8px;
        width: 4px;
        border-radius: 4px;
        background: linear-gradient(to bottom, var(--brand), var(--accent-2));
      }
      .post-body h3 {
        font-weight: 700;
        font-size: 1.25rem;
        margin: 32px 0 14px;
        color: var(--text);
      }
      .post-body p {
        margin-bottom: 22px;
        color: var(--text-dim);
      }

      /* ===== تصاویر داخل محتوا ===== */
      .post-img {
        margin: 30px 0;
        border-radius: 20px;
        overflow: hidden;
        position: relative;
        box-shadow: var(--shadow-strong);
        border: 1px solid var(--line);
        transition: all 0.4s var(--ease);
      }
      .post-img:hover {
        transform: scale(1.01);
        border-color: color-mix(in srgb, var(--accent-2) 40%, transparent);
      }
      .post-img img {
        width: 100%;
        height: auto;
        display: block;
      }
      .post-img .caption {
        padding: 14px 20px;
        background: var(--surface-2);
        font-size: 0.85rem;
        color: var(--text-dim);
        text-align: center;
        border-top: 1px solid var(--line);
      }
      .post-img .caption i {
        color: var(--accent-2);
        margin-left: 8px;
      }

      .post-img-right {
        float: right;
        margin: 8px 0 20px 28px;
        max-width: 45%;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-strong);
      }
      .post-img-right img {
        width: 100%;
        display: block;
      }
      .post-img-left {
        float: left;
        margin: 8px 28px 20px 0;
        max-width: 45%;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-strong);
      }
      .post-img-left img {
        width: 100%;
        display: block;
      }

      .post-body ul,
      .post-body ol {
        margin-bottom: 22px;
        padding-right: 24px;
        color: var(--text-dim);
      }
      .post-body li {
        margin-bottom: 10px;
        position: relative;
        padding-right: 8px;
      }
      .post-body ul li::marker {
        color: var(--accent-2);
      }
      .post-body blockquote {
        border-right: 4px solid var(--accent-2);
        padding: 24px 32px;
        margin: 34px 0;
        background: color-mix(in srgb, var(--surface-2) 50%, transparent);
        border-radius: 16px;
        font-style: italic;
        color: var(--text);
        position: relative;
        box-shadow: var(--shadow-strong);
      }
      .post-body blockquote::before {
        content: "\f10d";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        position: absolute;
        top: -16px;
        right: 20px;
        font-size: 1.8rem;
        color: var(--accent-2);
        opacity: 0.3;
      }
      .post-body blockquote p {
        margin: 0;
        color: var(--text);
        font-size: 1.05rem;
      }
      .post-body blockquote cite {
        display: block;
        margin-top: 12px;
        color: var(--text-dimmer);
        font-size: 0.85rem;
        font-style: normal;
      }

      /* ===== باکس نکته کلیدی دفرمه (Premium Box) ===== */
      .highlight-box.premium-box {
        background: linear-gradient(
          145deg,
          color-mix(in srgb, var(--brand) 12%, var(--surface)),
          color-mix(in srgb, var(--accent-2) 8%, var(--surface))
        );
        border: 1px solid color-mix(in srgb, var(--accent-2) 35%, transparent);
        border-radius: 24px;
        padding: 0;
        margin: 32px 0;
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 40px -12px color-mix(in srgb, var(--brand) 30%, transparent),
          inset 0 1px 0 rgba(255, 255, 255, 0.06);
        transition: all 0.5s var(--ease);
      }

      .highlight-box.premium-box:hover {
        transform: translateY(-4px) scale(1.01);
        border-color: var(--accent-2);
        box-shadow: 0 20px 60px -16px color-mix(in srgb, var(--brand) 40%, transparent);
      }

      .highlight-box.premium-box .premium-box-inner {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 24px 28px;
        position: relative;
        z-index: 2;
        flex-wrap: wrap;
      }

      /* آیکون */
      .highlight-box.premium-box .premium-box-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--brand), var(--accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--oncta);
        flex: none;
        box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--brand) 60%, transparent);
        position: relative;
      }

      .highlight-box.premium-box .premium-box-icon::after {
        content: "";
        position: absolute;
        inset: -4px;
        border-radius: 20px;
        border: 2px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
        animation: iconPulse 2.8s ease-in-out infinite;
      }

      @keyframes iconPulse {
        0%,
        100% {
          transform: scale(1);
          opacity: 0.4;
        }
        50% {
          transform: scale(1.12);
          opacity: 1;
        }
      }

      /* محتوای متن */
      .highlight-box.premium-box .premium-box-content {
        flex: 1;
        min-width: 180px;
      }

      .highlight-box.premium-box .premium-box-label {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent-2);
        background: color-mix(in srgb, var(--accent-2) 15%, transparent);
        padding: 3px 14px;
        border-radius: 99px;
        border: 1px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
        margin-bottom: 8px;
      }

      .highlight-box.premium-box .premium-box-content p {
        margin: 0;
        color: var(--text);
        font-size: 1rem;
        line-height: 1.9;
        font-weight: 500;
      }

      .highlight-box.premium-box .premium-box-content p strong {
        color: var(--accent-2);
        font-weight: 700;
      }

      /* تصویر */
      .highlight-box.premium-box .premium-box-image {
        width: 70px;
        height: 70px;
        border-radius: 16px;
        overflow: hidden;
        flex: none;
        border: 2px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
        box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.3);
        transition: all 0.5s var(--ease);
      }

      .highlight-box.premium-box:hover .premium-box-image {
        transform: rotate(-6deg) scale(1.05);
        border-color: var(--accent-2);
      }

      .highlight-box.premium-box .premium-box-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* دکوریشن پس‌زمینه */
      .highlight-box.premium-box::before {
        content: "";
        position: absolute;
        top: -60px;
        right: -60px;
        width: 200px;
        height: 200px;
        background: radial-gradient(
          circle,
          color-mix(in srgb, var(--brand) 20%, transparent),
          transparent 70%
        );
        border-radius: 50%;
        pointer-events: none;
      }

      .highlight-box.premium-box::after {
        content: "";
        position: absolute;
        bottom: -80px;
        left: -40px;
        width: 160px;
        height: 160px;
        background: radial-gradient(
          circle,
          color-mix(in srgb, var(--accent-2) 15%, transparent),
          transparent 70%
        );
        border-radius: 50%;
        pointer-events: none;
      }

      /* ===== تگ‌ها ===== */
      .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 40px 0 30px;
        padding-top: 30px;
        border-top: 1px solid var(--line);
        clear: both;
      }
      .post-tags a {
        padding: 8px 18px;
        border-radius: 99px;
        background: var(--surface-2);
        border: 1px solid var(--line);
        font-size: 0.8rem;
        color: var(--text-dim);
        transition: all 0.3s var(--ease);
        position: relative;
        overflow: hidden;
      }
      .post-tags a::before {
        content: "#";
        opacity: 0.5;
        margin-left: 4px;
      }
      .post-tags a:hover {
        background: var(--accent-2);
        color: var(--oncta);
        border-color: transparent;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--accent-2) 60%, transparent);
      }

      /* ===== اشتراک‌گذاری ===== */
      .share-bar {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        margin: 30px 0;
        flex-wrap: wrap;
        clear: both;
      }
      .share-bar span {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--text-dim);
      }
      .share-bar a {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-dim);
        transition: all 0.35s var(--ease);
        font-size: 0.95rem;
      }
      .share-bar a:hover {
        transform: translateY(-4px) scale(1.05);
        border-color: transparent;
      }
      .share-bar a.telegram:hover {
        background: #0088cc;
        color: #fff;
      }
      .share-bar a.twitter:hover {
        background: #000;
        color: #fff;
      }
      .share-bar a.linkedin:hover {
        background: #0a66c2;
        color: #fff;
      }
      .share-bar a.whatsapp:hover {
        background: #25d366;
        color: #fff;
      }

      /* ===== نظرات ===== */
      .comments-section {
        padding: 50px 0 0;
      }
      .comments-section .section-title-sm {
        font-weight: 800;
        font-size: 1.4rem;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .comments-section .section-title-sm i {
        color: var(--accent-2);
      }
      .comment-item {
        display: flex;
        gap: 18px;
        padding: 24px 0;
        border-bottom: 1px solid var(--line);
        transition: 0.3s;
      }
      .comment-item:last-child {
        border-bottom: none;
      }
      .comment-item:hover {
        padding-right: 12px;
      }
      .comment-item .cav {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--oncta);
        font-size: 0.95rem;
        overflow: hidden;
      }
      .comment-item .cav img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .comment-item .cbody h6 {
        font-weight: 700;
        margin: 0 0 4px;
        font-size: 0.95rem;
      }
      .comment-item .cbody .date {
        font-size: 0.74rem;
        color: var(--text-dimmer);
      }
      .comment-item .cbody p {
        margin: 8px 0 0;
        color: var(--text-dim);
        font-size: 0.9rem;
        line-height: 1.8;
      }
      .comment-item .cbody .reply-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 10px;
        font-size: 0.8rem;
        color: var(--accent-2);
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
      }
      .comment-item .cbody .reply-btn:hover {
        gap: 10px;
      }

      /* ===== فرم نظر ===== */
      .comment-form {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 32px;
        margin-top: 40px;
      }
      .comment-form textarea {
        width: 100%;
        background: var(--bg-soft);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 16px 20px;
        color: var(--text);
        font-family: inherit;
        font-size: 0.92rem;
        min-height: 110px;
        resize: vertical;
        transition: 0.3s;
      }
      .comment-form textarea:focus {
        outline: none;
        border-color: var(--accent-2);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-2) 15%, transparent);
      }
      .comment-form input {
        width: 100%;
        background: var(--bg-soft);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 14px 18px;
        color: var(--text);
        font-family: inherit;
        font-size: 0.92rem;
        margin-bottom: 14px;
        transition: 0.3s;
      }
      .comment-form input:focus {
        outline: none;
        border-color: var(--accent-2);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-2) 15%, transparent);
      }
      .comment-form .btn-flow {
        border: none;
        width: 100%;
        justify-content: center;
      }

      /* ===== سایدبار ===== */
      .sidebar-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 28px;
        margin-bottom: 28px;
        transition: all 0.4s var(--ease);
        box-shadow: var(--shadow-strong);
      }
      .sidebar-card:hover {
        border-color: color-mix(in srgb, var(--accent-2) 30%, transparent);
        transform: translateY(-4px);
      }
      .sidebar-card h5 {
        font-weight: 700;
        margin-bottom: 20px;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .sidebar-card h5 i {
        color: var(--accent-2);
      }
      .sidebar-card h5::after {
        content: "";
        flex: 1;
        height: 2px;
        background: linear-gradient(to left, var(--line), transparent);
        margin-right: 12px;
      }

      .related-item {
        display: flex;
        gap: 14px;
        padding-bottom: 18px;
        margin-bottom: 18px;
        border-bottom: 1px solid var(--line);
        transition: 0.3s;
        cursor: pointer;
      }
      .related-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
      }
      .related-item:hover {
        padding-right: 8px;
      }
      .related-item .thumb {
        width: 70px;
        height: 70px;
        border-radius: 14px;
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.8);
        transition: 0.3s;
        overflow: hidden;
      }
      .related-item .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .related-item:hover .thumb {
        transform: scale(1.05);
      }
      .related-item .thumb.t1 {
        background: linear-gradient(150deg, #1d2a6b, #0b1030);
      }
      .related-item .thumb.t2 {
        background: linear-gradient(150deg, #0d5c52, #07211d);
      }
      .related-item .thumb.t3 {
        background: linear-gradient(150deg, #6b2a4a, #2b0f1e);
      }
      .related-item .rinfo h6 {
        font-weight: 700;
        font-size: 0.88rem;
        margin: 0 0 4px;
        line-height: 1.5;
      }
      .related-item .rinfo span {
        font-size: 0.74rem;
        color: var(--text-dimmer);
      }

      .sidebar-cat-list a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid var(--line);
        color: var(--text-dim);
        font-size: 0.87rem;
        transition: all 0.3s var(--ease);
      }
      .sidebar-cat-list a:last-child {
        border-bottom: none;
      }
      .sidebar-cat-list a:hover {
        color: var(--accent-2);
        padding-right: 8px;
      }
      .sidebar-cat-list a span {
        background: var(--surface-2);
        padding: 2px 10px;
        border-radius: 99px;
        font-size: 0.7rem;
        color: var(--text-dimmer);
        transition: 0.3s;
      }
      .sidebar-cat-list a:hover span {
        background: var(--accent-2);
        color: var(--oncta);
      }

      /* ===== ریسپانسیو ===== */
      @media (max-width: 991px) {
        .single-hero {
          padding: 120px 0 30px;
        }
        .single-author-box {
          flex-direction: column;
          text-align: center;
          padding: 20px;
        }
        .single-author-box .social-links {
          margin-right: 0;
        }
        .post-body {
          font-size: 0.96rem;
        }
        .post-img-right,
        .post-img-left {
          float: none;
          max-width: 100%;
          margin: 20px 0;
        }
        .comments-section {
          padding: 30px 0 0;
        }
        .comment-form {
          padding: 24px 18px;
        }
        .share-bar {
          justify-content: center;
        }
        .highlight-box.premium-box .premium-box-inner {
          flex-direction: column;
          text-align: center;
          padding: 24px 20px;
        }
        .highlight-box.premium-box .premium-box-image {
          width: 60px;
          height: 60px;
          order: -1;
        }
        .highlight-box.premium-box .premium-box-icon {
          width: 50px;
          height: 50px;
          font-size: 1.2rem;
        }
        .highlight-box.premium-box .premium-box-content p {
          font-size: 0.92rem;
        }
      }

      @media (max-width: 576px) {
        .container-x {
          padding: 0 16px;
        }
        .single-hero h1 {
          font-size: 1.7rem;
        }
        .post-meta-top {
          gap: 10px;
          font-size: 0.78rem;
        }
        .post-body h2 {
          font-size: 1.3rem;
          padding-right: 14px;
        }
        .post-body blockquote {
          padding: 18px 20px;
          margin: 24px 0;
        }
        .post-body blockquote p {
          font-size: 0.95rem;
        }
        .sidebar-card {
