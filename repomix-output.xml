    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
}

/* استایل‌های درختی (Tree View) */
.chapter-box {
    border: 1px solid var(--border-color);
    border-radius: 12px;
    margin-bottom: 20px;
    background: #fff;
    overflow: hidden;
    transition: all 0.3s;
}

.chapter-header {
    background: #fdfdfd;
    padding: 15px 20px;
    border-bottom: 1px solid #f0f0f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.chapter-title-input {
    border: none;
    background: transparent;
    font-weight: bold;
    font-size: 1.1rem;
    width: 100%;
    outline: none;
    color: #333;
}

.episodes-container {
    padding: 15px 20px;
    background: #fafafa;
    border-top: 1px dashed var(--border-color);
}

.episode-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    background: #fff;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #eee;
}

.episode-row:hover {
    border-color: #ccc;
}

.btn-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    transition: 0.2s;
}

.btn-del-ch {
    background: #fee2e2;
    color: #ef4444;
}

.btn-del-ch:hover {
    background: #fecaca;
}

.btn-del-ep {
    background: transparent;
    color: #999;
}

.btn-del-ep:hover {
    color: #ef4444;
    background: #fee2e2;
}

.tree-line {
    width: 2px;
    background: #ddd;
    margin-right: 15px;
    height: 100%;
}

/* --- استایل چک‌باکس‌های دسته‌بندی (بدون کتابخانه) --- */
.categories-wrapper {
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    max-height: 250px;
    overflow-y: auto;
}

.category-item {
    display: flex;
    align-items: center;
    padding: 10px;
    border-bottom: 1px solid #f0f0f0;
    transition: background 0.2s;
    cursor: pointer;
}

.category-item:last-child {
    border-bottom: none;
}

.category-item:hover {
    background-color: #f9f9f9;
}

.category-checkbox {
    appearance: none;
    width: 20px;
    height: 20px;
    border: 2px solid #ccc;
    border-radius: 6px;
    margin-left: 12px;
    position: relative;
    cursor: pointer;
    transition: all 0.2s;
}

.category-checkbox:checked {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
}

.category-checkbox:checked::after {
    content: '✔';
    position: absolute;
    color: white;
    font-size: 12px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

.category-label {
    font-size: 0.95rem;
    color: #444;
    cursor: pointer;
    user-select: none;
}

.tags-box {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.tag-item {
    position: relative;
}

.tag-item input {
    display: none;
}

.tag-item span {
    padding: 8px 14px;
    border-radius: 20px;
    background: #f1f3f7;
    cursor: pointer;
    font-size: 13px;
    transition: .2s;
    border: 1px solid transparent;
}

.tag-item input:checked+span {
    background: linear-gradient(45deg, #667eea, #764ba2);
    color: #fff;
    border-color: #667eea;
}

.cover-preview-box {
    border: 1px solid #e3e3e3;
    border-radius: 10px;
    padding: 15px;
    display: flex;
    align-items: center;
    gap: 15px;
    background: #fafafa;
}

.cover-preview-box img {
    width: 90px;
    height: 90px;
    border-radius: 8px;
    object-fit: cover;
}

.page-loader {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    z-index: 9999;
    visibility: hidden;
    opacity: 0;
    transition: 0.3s;
}

.page-loader.active {
    visibility: visible;
    opacity: 1;
}

.loader-spinner {
    width: 60px;
    height: 60px;
    border: 5px solid #eee;
    border-top: 5px solid #4f46e5;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 12px;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.page-loader p {
    color: #fff;
    font-weight: 600;
}
