<file path="public/style/admin/comment.css">
.comment-user {
    text-decoration: none;
    font-weight: 600;
    color: #0d6efd;
}

.comment-user:hover {
    text-decoration: underline;
}

.comment-product {
    text-decoration: none;
    color: #444;
}

.comment-product:hover {
    color: #0d6efd;
}

.comment-text {
    max-width: 350px;
    font-size: 14px;
    color: #555;
}

