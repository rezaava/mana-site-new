  padding: 10px 20px;
  outline: none;
  border: none;
  font-size: 1em;
  color: #fff;
  background: rgba(15, 23, 42, 0.4);
  border: 2px solid rgba(6, 182, 212, 0.3);
  border-radius: 30px;
  transition: 0.3s;
  text-align: right;
  font-family: "Vazirmatn", sans-serif;
}

input:focus {
  border-color: #06b6d4;
  background: rgba(15, 23, 42, 0.6);
  box-shadow: 0 0 10px rgba(6, 182, 212, 0.3);
