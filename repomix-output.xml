      }
      .post-img .caption {
        padding: 14px 20px;
        background: var(--surface-2);
        font-size: 0.85rem;
        color: var(--text-dim);
        text-align: center;
        border-top: 1px solid var(--line);
      }
      .post-img .caption i {
        color: var(--accent-2);
        margin-left: 8px;
      }

      .post-img-right {
        float: right;
        margin: 8px 0 20px 28px;
        max-width: 45%;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--line);
