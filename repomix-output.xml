  }
  .blog-layout {
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .blog-feature {
    order: -1;
    min-height: 260px;
  }
  .footer-inner {
    padding-top: 44px;
  }
  .footer-island {
    padding: 30px 20px 0;
    border-radius: 26px;
  }
  .footer-3col {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 34px;
    padding-bottom: 30px;
  }
  .footer-col h5::after {
