  font-size: 0.92rem;
  transition: all 0.35s var(--ease);
}
.tech-pill:hover {
  transform: translateY(-5px);
  border-color: var(--accent-2);
  box-shadow: var(--shadow-strong);
}
.tech-pill i {
  font-size: 1.2rem;
  color: var(--accent-2);
}

/* ============ PROJECT INFO ============ */
.pinfo {
  padding: 100px 0;
}
.pinfo-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.pinfo-card {
  padding: 26px;
  border-radius: 20px;
  background: var(--surface);
  border: 1px solid var(--line);
  text-align: center;
}
.pinfo-card i {
  font-size: 1.4rem;
  color: var(--accent-2);
  margin-bottom: 14px;
}
.pinfo-card h6 {
  font-size: 0.78rem;
  color: var(--text-dimmer);
  font-weight: 600;
  margin-bottom: 6px;
}
.pinfo-card p {
  font-weight: 700;
  font-size: 0.96rem;
  margin: 0;
}
.pinfo-services {
  margin-top: 26px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
}
.pinfo-services span {
  padding: 9px 18px;
  border-radius: 99px;
  background: color-mix(in srgb, var(--brand) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--brand) 25%, transparent);
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text);
}

/* ============ SIMILAR PROJECTS ============ */
.similar {
  padding: 100px 0;
  background: var(--bg-soft);
}
.sim-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.sim-card {
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid var(--line);
  background: var(--surface);
  transition: transform 0.4s var(--ease);
}
.sim-card:hover {
  transform: translateY(-6px);
}
.sim-thumb {
  aspect-ratio: 16/10;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  color: #fff;
}
.sim-thumb.t1 {
  background: linear-gradient(150deg, #0d5c52, #07211d);
}
.sim-thumb.t2 {
  background: linear-gradient(150deg, #6b2a4a, #2b0f1e);
}
.sim-thumb.t3 {
  background: linear-gradient(150deg, #2f7dfb, #0d1030);
}
