      .stat-card .change.up {
        color: var(--accent-2);
        background: color-mix(in srgb, var(--accent-2) 15%, transparent);
      }
      .stat-card .change.down {
        color: #ef4444;
        background: color-mix(in srgb, #ef4444 15%, transparent);
      }
      .stat-card .stat-bg {
        position: absolute;
        bottom: -25px;
        left: -15px;
        font-size: 4.5rem;
        opacity: 0.04;
        pointer-events: none;
      }

      /* ===== CHARTS ROW ===== */
      .charts-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
      }
      .chart-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 22px;
        box-shadow: var(--shadow-strong);
        transition: all 0.4s var(--ease);
      }
      .chart-card:hover {
        border-color: color-mix(in srgb, var(--accent-2) 30%, transparent);
      }
      .chart-card .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 8px;
      }
      .chart-card .card-header h6 {
        font-weight: 700;
        margin: 0;
        font-size: 0.9rem;
      }
      .chart-card .card-header .filter-btns {
        display: flex;
        gap: 5px;
      }
      .chart-card .card-header .filter-btns button {
        padding: 3px 12px;
        border-radius: 99px;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--text-dim);
        font-size: 0.68rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        font-family: inherit;
      }
      .chart-card .card-header .filter-btns button:hover,
      .chart-card .card-header .filter-btns button.active {
        background: var(--brand);
        color: var(--oncta);
        border-color: var(--brand);
      }
      .chart-card canvas {
        width: 100% !important;
        max-height: 230px;
      }

      /* ===== BOTTOM ROW ===== */
      .bottom-row {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 20px;
        margin-bottom: 24px;
      }
      .visitor-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 22px;
        box-shadow: var(--shadow-strong);
        transition: all 0.4s var(--ease);
