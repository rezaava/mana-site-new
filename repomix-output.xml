  font-weight: 600;
  color: var(--text);
}

/* ============ SIMILAR PROJECTS ============ */
.similar {
  padding: 100px 0;
  background: var(--bg-soft);
}
.sim-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.sim-card {
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid var(--line);
  background: var(--surface);
  transition: transform 0.4s var(--ease);
}
.sim-card:hover {
  transform: translateY(-6px);
}
.sim-thumb {
  aspect-ratio: 16/10;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  color: #fff;
}
.sim-thumb.t1 {
  background: linear-gradient(150deg, #0d5c52, #07211d);
}
.sim-thumb.t2 {
  background: linear-gradient(150deg, #6b2a4a, #2b0f1e);
}
.sim-thumb.t3 {
  background: linear-gradient(150deg, #2f7dfb, #0d1030);
}
.sim-body {
  padding: 22px;
}
.sim-body span.tag {
  color: var(--accent-2);
  font-size: 0.74rem;
  font-weight: 700;
}
.sim-body h4 {
  font-weight: 700;
  font-size: 1.02rem;
  margin: 8px 0 14px;
}
.sim-body a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.84rem;
  font-weight: 700;
  color: var(--brand);
}
[data-theme="dark"] .sim-body a {
  color: var(--accent-2);
}

/* ============ FINAL CTA BANNER ============ */
.final-cta {
  padding: 20px 0 100px;
}
.cta-banner {
  position: relative;
  overflow: hidden;
  border-radius: 36px;
  padding: 70px 40px;
  text-align: center;
  background: linear-gradient(
    135deg,
    var(--brand),
    var(--brand-deep) 55%,
    var(--accent-2)
  );
}
.cta-banner::before {
  content: "";
  position: absolute;
  width: 420px;
  height: 420px;
  background: radial-gradient(
    circle,
    rgba(255, 255, 255, 0.16),
    transparent 70%
  );
  top: -160px;
  right: -100px;
}
.cta-banner::after {
  content: "";
  position: absolute;
  width: 340px;
  height: 340px;
  background: radial-gradient(
    circle,
    rgba(255, 255, 255, 0.12),
    transparent 70%
  );
  bottom: -140px;
  left: -80px;
}
.cta-banner h2 {
  position: relative;
  z-index: 2;
  font-size: clamp(1.7rem, 3.4vw, 2.5rem);
  font-weight: 800;
  color: #fff;
  margin-bottom: 16px;
}
.cta-banner p {
  position: relative;
  z-index: 2;
  color: rgba(255, 255, 255, 0.85);
