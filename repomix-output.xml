    transform: translateX(50%);
  }
  .footer-col ul li a {
    justify-content: center;
  }
  .footer-center {
    order: -1;
  }
  .footer-badges {
    gap: 18px;
    padding-top: 20px;
    padding-bottom: 26px;
  }
  .footer-newsletter {
    padding: 18px 20px;
  }
  .folio-shell {
