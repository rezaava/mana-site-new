}
.cta-banner .btn-flow {
  position: relative;
  z-index: 2;
  background: #fff;
  color: var(--brand-deep);
  box-shadow: 0 14px 34px -10px rgba(0, 0, 0, 0.35);
}
.cta-banner .btn-flow:hover {
  color: var(--brand-deep);
}

/* ============ PREV/NEXT PROJECT NAV ============ */
.pn-nav {
  padding: 0 0 90px;
}
.pn-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.pn-item {
  display: flex;
  align-items: center;
  gap: 16px;
