<file path="public/css/paneladmin.css">
/* ===== THEME TOKENS ===== */
      :root {
        --r-xl: 34px;
        --r-lg: 24px;
        --r-md: 16px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        --sidebar-width: 280px;
      }
      [data-theme="dark"] {
        --bg: #060a14;
        --bg-soft: #0a0f20;
        --surface: #0f1730;
        --surface-2: #141d3f;
        --line: rgba(255, 255, 255, 0.09);
        --text: #f4f6fb;
        --text-dim: #9aa3c8;
        --text-dimmer: #666fa0;
        --brand: #2f7dfb;
        --brand-deep: #033f88;
        --accent: #ffb020;
        --accent-2: #17c3b2;
        --shadow-strong: 0 20px 50px -14px rgba(0, 0, 0, 0.65);
        --oncta: #04101f;
        --card-hover: rgba(47, 125, 251, 0.08);
      }
      [data-theme="light"] {
        --bg: #f0f4f9;
        --bg-soft: #ffffff;
        --surface: #ffffff;
        --surface-2: #e8eef6;
        --line: rgba(3, 63, 136, 0.13);
        --text: #0a152e;
        --text-dim: #4b5678;
        --text-dimmer: #828cad;
        --brand: #033f88;
        --brand-deep: #022a5c;
        --accent: #e2900d;
        --accent-2: #0d9e91;
        --shadow-strong: 0 20px 50px -18px rgba(3, 63, 136, 0.28);
        --oncta: #ffffff;
        --card-hover: rgba(3, 63, 136, 0.05);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: "Vazirmatn", sans-serif;
        background: var(--bg);
        color: var(--text);
        transition: all 0.4s var(--ease);
        overflow-x: hidden;
      }
      ::-webkit-scrollbar {
        width: 7px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--surface-2);
        border-radius: 10px;
      }

      .cur-dot,
      .cur-ring {
        position: fixed;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: 9999;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        will-change: transform;
      }
      .cur-dot {
        width: 7px;
        height: 7px;
        background: var(--accent);
        transition: transform 0.15s var(--ease), background 0.3s;
      }
      .cur-ring {
        width: 34px;
        height: 34px;
        border: 1.5px solid var(--brand);
        transition: width 0.3s var(--ease), height 0.3s var(--ease),
          border-color 0.3s, background 0.3s;
      }
      .cur-ring.hover {
        width: 58px;
        height: 58px;
        background: rgba(47, 125, 251, 0.12);
        border-color: var(--accent-2);
      }
      @media (pointer: coarse) {
        .cur-dot,
        .cur-ring {
          display: none;
        }
      }

      /* ===== SIDEBAR ===== */
      .admin-wrapper {
        display: flex;
        min-height: 100vh;
      }

      .sidebar {
        position: fixed;
        top: 0;
        right: 0;
        width: var(--sidebar-width);
        height: 100vh;
        background: var(--surface);
        border-left: 1px solid var(--line);
        padding: 20px 16px 20px;
        overflow-y: auto;
        z-index: 1050;
        transition: all 0.4s var(--ease);
        box-shadow: var(--shadow-strong);
      }
      .sidebar.collapsed {
        transform: translateX(calc(var(--sidebar-width) + 20px));
      }

      .sidebar .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        font-size: 1.1rem;
        padding: 0 10px 20px;
        border-bottom: 1px solid var(--line);
        margin-bottom: 16px;
      }
      .sidebar .brand .mark {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--brand), var(--accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--oncta);
        font-size: 1.1rem;
        overflow: hidden;
      }
      .sidebar .brand .mark img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .sidebar .menu-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-dimmer);
        padding: 12px 10px 6px;
        font-weight: 700;
      }

      .sidebar .nav-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 11px 16px;
        border-radius: 12px;
        color: var(--text-dim);
        transition: all 0.3s var(--ease);
        cursor: pointer;
        margin-bottom: 3px;
        position: relative;
        border: none;
        background: transparent;
        width: 100%;
        text-align: right;
        font-family: inherit;
        font-size: 0.88rem;
        font-weight: 500;
      }
      .sidebar .nav-item:hover {
        background: var(--card-hover);
        color: var(--text);
      }
      .sidebar .nav-item.active {
        background: linear-gradient(135deg, var(--brand), var(--accent-2));
        color: var(--oncta);
        box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--brand) 60%, transparent);
      }
      .sidebar .nav-item i {
        width: 20px;
        font-size: 1rem;
      }
      .sidebar .nav-item .badge-dot {
        margin-right: auto;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
      }
      .sidebar .nav-item .badge-num {
        margin-right: auto;
        background: var(--accent);
        color: var(--oncta);
        font-size: 0.65rem;
        padding: 1px 9px;
        border-radius: 99px;
        font-weight: 700;
      }

      .sidebar .nav-item.has-sub {
        position: relative;
      }
      .sidebar .nav-item.has-sub .arrow {
        margin-right: auto;
        transition: transform 0.3s var(--ease);
        font-size: 0.65rem;
      }
      .sidebar .nav-item.has-sub.open .arrow {
        transform: rotate(90deg);
      }

      .sidebar .sub-menu {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s var(--ease);
        padding-right: 16px;
      }
      .sidebar .sub-menu.open {
        max-height: 500px;
      }
      .sidebar .sub-menu .nav-item {
        padding: 8px 16px;
        font-size: 0.82rem;
        color: var(--text-dimmer);
        border-radius: 10px;
      }
      .sidebar .sub-menu .nav-item:hover {
        color: var(--text);
        background: var(--card-hover);
      }
      .sidebar .sub-menu .nav-item.active {
        background: var(--card-hover);
        color: var(--text);
      }

      /* دراپ‌داون یکسان و کنترل‌شده با جاوااسکریپت در همه سایزها */
      .sidebar .nav-item.has-sub .arrow {
        transform: rotate(0deg);
      }
      .sidebar .nav-item.has-sub.open .arrow {
        transform: rotate(90deg);
      }

      .sidebar .user-card {
        margin-top: 16px;
        padding: 14px 16px;
        border-radius: 14px;
        background: var(--card-hover);
        border: 1px solid var(--line);
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .sidebar .user-card .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand), var(--accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--oncta);
        font-size: 0.9rem;
        flex: none;
        overflow: hidden;
      }
      .sidebar .user-card .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .sidebar .user-card .info h6 {
        font-weight: 700;
        margin: 0;
        font-size: 0.88rem;
      }
      .sidebar .user-card .info span {
        font-size: 0.74rem;
        color: var(--text-dimmer);
      }

      /* ===== MAIN CONTENT ===== */
      .main-content {
        flex: 1;
        margin-right: var(--sidebar-width);
        padding: 20px 28px 40px;
        transition: margin 0.4s var(--ease);
        min-height: 100vh;
      }
      .main-content.expanded {
        margin-right: 20px;
      }

      /* ===== TOP BAR ===== */
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0 20px;
        border-bottom: 1px solid var(--line);
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
      }
      .topbar .left {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .topbar .left .toggle-btn {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--text);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.3s;
        font-size: 1rem;
      }
      .topbar .left .toggle-btn:hover {
        background: var(--card-hover);
        border-color: var(--accent-2);
      }
      .topbar .left h4 {
        font-weight: 700;
        margin: 0;
        font-size: 1.15rem;
      }
      .topbar .right {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .topbar .right .theme-switch {
        width: 50px;
        height: 28px;
        border-radius: 99px;
        border: 1px solid var(--line);
        background: var(--surface-2);
        position: relative;
        cursor: pointer;
        flex: none;
      }
      .topbar .right .theme-switch .knob {
        position: absolute;
        top: 3px;
        right: 3px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand), var(--accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--oncta);
        font-size: 0.6rem;
        transition: transform 0.4s var(--ease);
      }
      [data-theme="light"] .topbar .right .theme-switch .knob {
        transform: translateX(-20px);
      }
      .topbar .right .notif-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--text-dim);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.3s;
        position: relative;
      }
      .topbar .right .notif-btn:hover {
        border-color: var(--accent-2);
        color: var(--text);
      }
      .topbar .right .notif-btn .dot {
        position: absolute;
        top: 9px;
        left: 9px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
        border: 2px solid var(--surface);
      }

      /* ===== STATS CARDS ===== */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 24px;
      }
      .stat-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 20px 22px;
        transition: all 0.4s var(--ease);
        box-shadow: var(--shadow-strong);
        position: relative;
        overflow: hidden;
      }
      .stat-card:hover {
        transform: translateY(-5px);
        border-color: color-mix(in srgb, var(--accent-2) 40%, transparent);
      }
      .stat-card .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 12px;
        color: var(--oncta);
      }
      .stat-card .stat-icon.blue {
        background: linear-gradient(135deg, var(--brand), #4a8afb);
      }
      .stat-card .stat-icon.green {
        background: linear-gradient(135deg, var(--accent-2), #2ad4c0);
      }
      .stat-card .stat-icon.yellow {
        background: linear-gradient(135deg, var(--accent), #ffcc44);
      }
      .stat-card .stat-icon.purple {
        background: linear-gradient(135deg, #8b5cf6, #a78bfa);
      }
      .stat-card h3 {
        font-weight: 800;
        font-size: 1.6rem;
        margin: 0;
      }
      .stat-card span {
        color: var(--text-dim);
        font-size: 0.82rem;
      }
      .stat-card .change {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 2px 10px;
        border-radius: 99px;
        margin-top: 6px;
      }
      .stat-card .change.up {
        color: var(--accent-2);
        background: color-mix(in srgb, var(--accent-2) 15%, transparent);
      }
      .stat-card .change.down {
        color: #ef4444;
        background: color-mix(in srgb, #ef4444 15%, transparent);
      }
      .stat-card .stat-bg {
        position: absolute;
        bottom: -25px;
        left: -15px;
        font-size: 4.5rem;
        opacity: 0.04;
        pointer-events: none;
      }

      /* ===== CHARTS ROW ===== */
      .charts-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
      }
      .chart-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 22px;
        box-shadow: var(--shadow-strong);
        transition: all 0.4s var(--ease);
      }
      .chart-card:hover {
        border-color: color-mix(in srgb, var(--accent-2) 30%, transparent);
      }
      .chart-card .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 8px;
      }
      .chart-card .card-header h6 {
        font-weight: 700;
        margin: 0;
        font-size: 0.9rem;
      }
      .chart-card .card-header .filter-btns {
        display: flex;
        gap: 5px;
      }
      .chart-card .card-header .filter-btns button {
        padding: 3px 12px;
        border-radius: 99px;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--text-dim);
        font-size: 0.68rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        font-family: inherit;
      }
      .chart-card .card-header .filter-btns button:hover,
      .chart-card .card-header .filter-btns button.active {
        background: var(--brand);
        color: var(--oncta);
        border-color: var(--brand);
      }
      .chart-card canvas {
        width: 100% !important;
        max-height: 230px;
      }

      /* ===== BOTTOM ROW ===== */
      .bottom-row {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 20px;
        margin-bottom: 24px;
      }
      .visitor-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 22px;
        box-shadow: var(--shadow-strong);
        transition: all 0.4s var(--ease);
      }
      .visitor-card:hover {
        border-color: color-mix(in srgb, var(--accent-2) 30%, transparent);
      }
      .visitor-card h6 {
        font-weight: 700;
        margin-bottom: 14px;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .visitor-card h6 i {
        color: var(--accent-2);
      }

      .visitor-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid var(--line);
      }
      .visitor-item:last-child {
        border-bottom: none;
      }
      .visitor-item .label {
        color: var(--text-dim);
        font-size: 0.84rem;
        min-width: 70px;
      }
      .visitor-item .value {
        font-weight: 700;
        font-size: 0.88rem;
        min-width: 60px;
        text-align: left;
      }
      .visitor-item .bar-track {
        flex: 1;
        height: 5px;
        background: var(--surface-2);
        border-radius: 99px;
        margin: 0 12px;
        overflow: hidden;
      }
      .visitor-item .bar-track .bar-fill {
        height: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg, var(--brand), var(--accent-2));
        transition: width 1s var(--ease);
      }
      .visitor-item .bar-track .bar-fill.orange {
        background: linear-gradient(90deg, var(--accent), #ffcc44);
      }
      .visitor-item .bar-track .bar-fill.green {
        background: linear-gradient(90deg, var(--accent-2), #4ade80);
      }
      .visitor-item .bar-track .bar-fill.purple {
        background: linear-gradient(90deg, #8b5cf6, #a78bfa);
      }
      .visitor-item .bar-track .bar-fill.pink {
        background: linear-gradient(90deg, #ec4899, #f472b6);
      }

      /* ===== COMMENTS ===== */
      .comments-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 22px;
        box-shadow: var(--shadow-strong);
        transition: all 0.4s var(--ease);
        max-height: 380px;
        overflow-y: auto;
      }
      .comments-card:hover {
        border-color: color-mix(in srgb, var(--accent-2) 30%, transparent);
      }
      .comments-card h6 {
        font-weight: 700;
        margin-bottom: 14px;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .comments-card h6 i {
        color: var(--accent-2);
      }

      .comment-item {
        display: flex;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--line);
        transition: 0.3s;
        cursor: pointer;
      }
      .comment-item:last-child {
        border-bottom: none;
      }
      .comment-item:hover {
        padding-right: 6px;
      }
      .comment-item .cav {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--oncta);
        font-size: 0.8rem;
        overflow: hidden;
      }
      .comment-item .cav img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .comment-item .cbody h6 {
        font-weight: 700;
        margin: 0 0 2px;
        font-size: 0.84rem;
      }
      .comment-item .cbody p {
        margin: 0;
        color: var(--text-dim);
        font-size: 0.8rem;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .comment-item .cbody .time {
        font-size: 0.68rem;
        color: var(--text-dimmer);
      }

      /* ===== GRAPHIC / MOTION POLISH (رنگ‌ها دست‌نخورده) ===== */
      @keyframes fadeUpIn {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .stat-card,
      .chart-card,
      .visitor-card,
      .comments-card {
        animation: fadeUpIn 0.5s var(--ease) both;
      }
      .stats-grid .stat-card:nth-child(1) { animation-delay: 0.02s; }
      .stats-grid .stat-card:nth-child(2) { animation-delay: 0.08s; }
      .stats-grid .stat-card:nth-child(3) { animation-delay: 0.14s; }
      .stats-grid .stat-card:nth-child(4) { animation-delay: 0.2s; }
      .charts-row .chart-card:nth-child(1) { animation-delay: 0.1s; }
      .charts-row .chart-card:nth-child(2) { animation-delay: 0.16s; }
      .bottom-row .visitor-card { animation-delay: 0.1s; }
      .bottom-row .comments-card { animation-delay: 0.16s; }

      .stat-card .stat-icon {
        transition: transform 0.4s var(--ease);
      }
      .stat-card:hover .stat-icon {
        transform: scale(1.1) rotate(-6deg);
      }

      .sidebar .nav-item::before {
        content: "";
        position: absolute;
        top: 50%;
        right: 0;
        transform: translateY(-50%);
        width: 3px;
        height: 0;
        border-radius: 99px;
