[data-theme="dark"] .sim-body a {
  color: var(--accent-2);
}

/* ============ FINAL CTA BANNER ============ */
.final-cta {
  padding: 20px 0 100px;
}
.cta-banner {
  position: relative;
  overflow: hidden;
  border-radius: 36px;
  padding: 70px 40px;
  text-align: center;
  background: linear-gradient(
    135deg,
    var(--brand),
    var(--brand-deep) 55%,
