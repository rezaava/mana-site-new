        position: relative;
        padding-right: 20px;
      }
      .post-body h2::before {
        content: "";
        position: absolute;
        right: 0;
        top: 8px;
        bottom: 8px;
        width: 4px;
        border-radius: 4px;
        background: linear-gradient(to bottom, var(--brand), var(--accent-2));
      }
      .post-body h3 {
        font-weight: 700;
        font-size: 1.25rem;
        margin: 32px 0 14px;
        color: var(--text);
      }
      .post-body p {
        margin-bottom: 22px;
