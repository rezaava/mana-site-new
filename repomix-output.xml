}

/* کارت فرم اصلی */
.info-card {
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.8);
    padding: 40px;
    position: relative;
    z-index: 2;
}

/* لیبل‌ها */
.form-label {
    font-weight: 700;
    color: #555;
    margin-bottom: 8px;
    font-size: 0.95rem;
}

/* گروه ورودی‌ها */
.input-group {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
}

.input-group:focus-within {
    box-shadow: 0 5px 15px rgba(79, 172, 254, 0.2);
    transform: translateY(-2px);
}

/* آیکون داخل اینپوت */
