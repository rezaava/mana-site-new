      }
      .post-img-left {
        float: left;
        margin: 8px 28px 20px 0;
        max-width: 45%;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-strong);
      }
      .post-img-left img {
        width: 100%;
        display: block;
      }

      .post-body ul,
      .post-body ol {
        margin-bottom: 22px;
        padding-right: 24px;
        color: var(--text-dim);
      }
      .post-body li {
        margin-bottom: 10px;
        position: relative;
        padding-right: 8px;
      }
      .post-body ul li::marker {
        color: var(--accent-2);
      }
      .post-body blockquote {
        border-right: 4px solid var(--accent-2);
        padding: 24px 32px;
        margin: 34px 0;
        background: color-mix(in srgb, var(--surface-2) 50%, transparent);
        border-radius: 16px;
