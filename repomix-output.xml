<file path="public/style/seller/product.css">
/* --- استایل‌های مدرن --- */
:root {
    --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --bg-light: #f8f9fa;
    --border-color: #e0e0e0;
    --text-muted: #6c757d;
