        }
      }
      :focus-visible {
        outline: 2px solid var(--accent-2);
        outline-offset: 3px;
        border-radius: 4px;
      }

      body.has-cursor,
      body.has-cursor * {
        cursor: none !important;
      }
      .cur-dot,
      .cur-ring {
        position: fixed;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: 9999;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        will-change: transform;
      }
      .cur-dot {
        width: 7px;
        height: 7px;
        background: var(--accent);
        transition:
          transform 0.15s var(--ease),
          background 0.3s;
      }
      .cur-ring {
        width: 34px;
        height: 34px;
        border: 1.5px solid var(--brand);
        transition:
          width 0.3s var(--ease),
          height 0.3s var(--ease),
          border-color 0.3s,
