<file path="public/style/client/footer.css">
/* تنظیمات پایه فوتر */
.custom-site-footer {
    background-color: #e5e5e5;
    /* رنگ پس زمینه دقیقاً مشابه عکس */
    font-family: 'Vazirmatn', 'IRANSans', sans-serif;
    position: relative;
    margin-top: 80px;
    padding-top: 40px;
    padding-bottom: 20px;
}

/* ساختار وسط چین */
.footer-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 20px;
}

/* --- هدر و لوگوی بالا --- */
.footer-top-brand {
    display: flex;
    justify-content: center;
    transform: translateY(-45%);
    /* لوگو را روی مرز می‌آورد */
}

.brand-card {
    padding: 20px 100px;
    border-radius: 0 0 100px 100px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.brand-text h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    color: #333;
}

.brand-text span {
    font-size: 13px;
    color: #888;
}

.brand-icon {
    width: 35px;
    height: 35px;
}

/* --- گرید ۵ ستونه --- */
.footer-grid-5 {
    display: grid;
    grid-template-columns: 1fr 1fr 2fr 1fr 1fr;
    /* ستون وسط عریض‌تر است */
    gap: 20px;
    margin-top: -20px;
    margin-bottom: 50px;
}

/* تیتر ستون‌ها */
.col-title {
    font-size: 16px;
    font-weight: bold;
    color: #111;
    text-align: center;
    margin-bottom: 25px;
    position: relative;
}

/* خط تیره آبی زیر تیترها */
.col-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 2px;
    background-color: #0855df;
    /* رنگ آبی سایت */
    border-radius: 2px;
}

/* لیست لینک‌ها */
.col-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.col-list li {
    margin-bottom: 15px;
    position: relative;
    padding-right: 15px;
    /* فاصله برای نقطه آبی */
    text-align: right;
}

/* دایره توپر آبی رنگ برای لیست‌ها */
.col-list li::before {
    content: '';
    position: absolute;
    right: 0;
    top: 9px;
    width: 5px;
    height: 5px;
    background-color: #0855df;
    border-radius: 50%;
}

.col-list li a {
    text-decoration: none;
    color: #555;
    font-size: 14px;
    transition: color 0.3s;
}

.col-list li a:hover {
    color: #0855df;
}

/* متن درباره فروشگاه */
.about-col p {
    font-size: 13px;
    color: #666;
    line-height: 2.2;
    text-align: justify;
    margin: 0;
}

/* باکس‌های خالی مجوز */
.license-boxes {
    display: flex;
    justify-content: center;
    gap: 15px;
}

.license-box {
    width: 75px;
    height: 75px;
    border: 1px solid #ccc;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 14px;
    background-color: transparent;
}

/* --- باکس سفید تماس با ما --- */
.footer-contact-bar {
    background-color: #fff;
    border-radius: 50px;
    padding: 15px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
}

.contact-message {
    font-size: 14px;
    color: #777;
}

.contact-info-pills {
    display: flex;
    gap: 15px;
    direction: ltr;
    /* برای نمایش درست آیکون و متن در چپ */
}

/* دکمه‌های آیکون دار ارتباطی */
.info-pill {
    background-color: #f4f7fc;
    border-radius: 50px;
    padding: 6px 15px;
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #555;
    font-size: 14px;
    transition: background 0.3s;
}

.info-pill:hover {
    background-color: #e5edf9;
}

.pill-icon {
    display: flex;
    align-items: center;
}

.pill-icon svg {
    width: 16px;
    height: 16px;
    color: #0855df;
}

/* --- کپی رایت و شبکه‌های اجتماعی (پایین فوتر) --- */
.footer-copyright-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
}

.copyright-text {
    font-size: 13px;
    color: #888;
}

.social-networks {
    display: flex;
    gap: 15px;
    direction: ltr;
}

.social-networks a {
    color: #0855df;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s;
}

.social-networks a:hover {
    transform: scale(1.15);
}

.social-networks svg {
    width: 20px;
    height: 20px;
}

.inamad {
    width: 100%;
    height: 100%;
}

/* ریسپانسیو (برای موبایل و تبلت) */
@media (max-width: 992px) {
    .brand-card {
        padding: 20px 70px;
    }

    .footer-grid-5 {
        grid-template-columns: 1fr 1fr;
        /* دو ستونه در تبلت */
    }

    .about-col {
        grid-column: span 2;
    }

    .footer-contact-bar {
        flex-direction: column;
        gap: 20px;
        text-align: center;
        border-radius: 20px;
    }

    .contact-info-pills {
        flex-wrap: wrap;
        justify-content: center;
    }
}

@media (max-width: 576px) {
    .brand-card {
        padding: 20px 50px;
    }

    .footer-grid-5 {
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .about-col {
        grid-column: span 2;
    }

    .footer-copyright-bar {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }
}
</file>

<file path="public/style/client/index.css">
/* Features Section Spacing */
#featuresSection,
#slider,
#cats,
#plans,
#new-items {
    margin-top: 40px !important;
}

.desc {
    height: 45px;
}

/* Hero Title Styling */
.hero-title {
    color: #333;
    line-height: 1.5;
}

.highlight-text {
    color: #4dabf7;
    position: relative;
    display: inline-block;
}

.highlight-text::after {
    content: '';
    position: absolute;
    bottom: 5px;
    left: 0;
    width: 100%;
    height: 10px;
    background-color: rgba(77, 171, 247, 0.2);
    z-index: -1;
    border-radius: 5px;
}

/* Hero Description Styling */
.hero-description {
    color: #666;
    font-size: 1rem;
    border-style: solid;
