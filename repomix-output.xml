    gap: 10px;
    overflow-x: auto;
    padding: 14px;
    border-left: none;
    border-bottom: 1px solid var(--line);
  }
  .folio-mobile-tabs .fmt-chip {
    flex: none;
    padding: 10px 18px;
    border-radius: 99px;
    border: 1px solid var(--line);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .folio-mobile-tabs .fmt-chip.active {
