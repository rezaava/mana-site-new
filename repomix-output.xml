/* ساختار وسط چین */
.footer-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 20px;
}

/* --- هدر و لوگوی بالا --- */
.footer-top-brand {
    display: flex;
    justify-content: center;
    transform: translateY(-45%);
    /* لوگو را روی مرز می‌آورد */
}

.brand-card {
    padding: 20px 100px;
    border-radius: 0 0 100px 100px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.brand-text h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    color: #333;
}

.brand-text span {
    font-size: 13px;
    color: #888;
}

.brand-icon {
    width: 35px;
    height: 35px;
}

/* --- گرید ۵ ستونه --- */
.footer-grid-5 {
    display: grid;
    grid-template-columns: 1fr 1fr 2fr 1fr 1fr;
    /* ستون وسط عریض‌تر است */
    gap: 20px;
    margin-top: -20px;
    margin-bottom: 50px;
}

/* تیتر ستون‌ها */
.col-title {
    font-size: 16px;
    font-weight: bold;
    color: #111;
    text-align: center;
    margin-bottom: 25px;
    position: relative;
}

/* خط تیره آبی زیر تیترها */
.col-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 2px;
    background-color: #0855df;
    /* رنگ آبی سایت */
    border-radius: 2px;
}

/* لیست لینک‌ها */
.col-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.col-list li {
    margin-bottom: 15px;
    position: relative;
    padding-right: 15px;
    /* فاصله برای نقطه آبی */
    text-align: right;
}

/* دایره توپر آبی رنگ برای لیست‌ها */
.col-list li::before {
    content: '';
    position: absolute;
    right: 0;
    top: 9px;
    width: 5px;
    height: 5px;
    background-color: #0855df;
    border-radius: 50%;
}

.col-list li a {
    text-decoration: none;
    color: #555;
    font-size: 14px;
