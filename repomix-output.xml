      .post-body h3 {
        font-weight: 700;
        font-size: 1.25rem;
        margin: 32px 0 14px;
        color: var(--text);
      }
      .post-body p {
        margin-bottom: 22px;
        color: var(--text-dim);
      }

      /* ===== تصاویر داخل محتوا ===== */
      .post-img {
        margin: 30px 0;
        border-radius: 20px;
        overflow: hidden;
        position: relative;
        box-shadow: var(--shadow-strong);
        border: 1px solid var(--line);
        transition: all 0.4s var(--ease);
      }
      .post-img:hover {
        transform: scale(1.01);
        border-color: color-mix(in srgb, var(--accent-2) 40%, transparent);
      }
      .post-img img {
        width: 100%;
        height: auto;
        display: block;
      }
      .post-img .caption {
        padding: 14px 20px;
        background: var(--surface-2);
        font-size: 0.85rem;
        color: var(--text-dim);
        text-align: center;
        border-top: 1px solid var(--line);
      }
      .post-img .caption i {
        color: var(--accent-2);
        margin-left: 8px;
      }

      .post-img-right {
        float: right;
        margin: 8px 0 20px 28px;
        max-width: 45%;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-strong);
      }
      .post-img-right img {
        width: 100%;
        display: block;
      }
      .post-img-left {
        float: left;
        margin: 8px 28px 20px 0;
        max-width: 45%;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-strong);
      }
      .post-img-left img {
        width: 100%;
        display: block;
      }

      .post-body ul,
      .post-body ol {
        margin-bottom: 22px;
        padding-right: 24px;
        color: var(--text-dim);
      }
      .post-body li {
        margin-bottom: 10px;
        position: relative;
        padding-right: 8px;
      }
      .post-body ul li::marker {
        color: var(--accent-2);
      }
      .post-body blockquote {
        border-right: 4px solid var(--accent-2);
        padding: 24px 32px;
        margin: 34px 0;
        background: color-mix(in srgb, var(--surface-2) 50%, transparent);
        border-radius: 16px;
        font-style: italic;
        color: var(--text);
        position: relative;
        box-shadow: var(--shadow-strong);
      }
      .post-body blockquote::before {
        content: "\f10d";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        position: absolute;
        top: -16px;
        right: 20px;
        font-size: 1.8rem;
        color: var(--accent-2);
        opacity: 0.3;
      }
      .post-body blockquote p {
        margin: 0;
        color: var(--text);
        font-size: 1.05rem;
      }
      .post-body blockquote cite {
        display: block;
        margin-top: 12px;
        color: var(--text-dimmer);
        font-size: 0.85rem;
        font-style: normal;
      }

      /* ===== باکس نکته کلیدی دفرمه (Premium Box) ===== */
      .highlight-box.premium-box {
        background: linear-gradient(
          145deg,
          color-mix(in srgb, var(--brand) 12%, var(--surface)),
          color-mix(in srgb, var(--accent-2) 8%, var(--surface))
        );
        border: 1px solid color-mix(in srgb, var(--accent-2) 35%, transparent);
        border-radius: 24px;
        padding: 0;
        margin: 32px 0;
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 40px -12px color-mix(in srgb, var(--brand) 30%, transparent),
          inset 0 1px 0 rgba(255, 255, 255, 0.06);
        transition: all 0.5s var(--ease);
      }

      .highlight-box.premium-box:hover {
        transform: translateY(-4px) scale(1.01);
        border-color: var(--accent-2);
        box-shadow: 0 20px 60px -16px color-mix(in srgb, var(--brand) 40%, transparent);
      }

      .highlight-box.premium-box .premium-box-inner {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 24px 28px;
        position: relative;
        z-index: 2;
        flex-wrap: wrap;
      }

      /* آیکون */
      .highlight-box.premium-box .premium-box-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--brand), var(--accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--oncta);
        flex: none;
        box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--brand) 60%, transparent);
        position: relative;
      }

      .highlight-box.premium-box .premium-box-icon::after {
        content: "";
        position: absolute;
        inset: -4px;
        border-radius: 20px;
        border: 2px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
        animation: iconPulse 2.8s ease-in-out infinite;
      }

      @keyframes iconPulse {
        0%,
        100% {
          transform: scale(1);
          opacity: 0.4;
        }
        50% {
          transform: scale(1.12);
          opacity: 1;
        }
      }

      /* محتوای متن */
      .highlight-box.premium-box .premium-box-content {
        flex: 1;
        min-width: 180px;
      }

      .highlight-box.premium-box .premium-box-label {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent-2);
        background: color-mix(in srgb, var(--accent-2) 15%, transparent);
        padding: 3px 14px;
        border-radius: 99px;
        border: 1px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
        margin-bottom: 8px;
