    border: none;
    padding: 0.6rem 1.5rem;
    border-radius: 40px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #5f7f9c;
}

.archive-btn i,
.courses-btn i {
    font-size: 1.1rem;
}

.archive-btn:hover,
.courses-btn:hover {
    background: #e2e9f2;
    color: #1e6f9f;
}

.courses-btn.active {
    background: linear-gradient(135deg, #1e6f9f, #0b4a6e);
    color: white;
    box-shadow: 0 4px 12px rgba(30, 111, 159, 0.4);
}

.courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.8rem;
    padding: 1.8rem;
}

.course-card {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    position: relative;
    text-decoration: none;
    display: block;
    cursor: pointer;
}

.course-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
}

.course-image {
    position: relative;
    width: 100%;
    height: 160px;
    overflow: hidden;
}

.course-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.course-card:hover .course-image img {
    transform: scale(1.1);
}

.course-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: linear-gradient(135deg, #22c55e, #16a34a);
    color: white;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.course-actions {
    padding: 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    background: #f8fafc;
    border-bottom: 1px solid #eef2f8;
}

.action-item {
    position: relative;
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
}

.action-item i {
    font-size: 1.3rem;
    color: #7c9ec0;
    transition: all 0.2s ease;
    padding: 8px;
    border-radius: 12px;
}

.action-item:hover i {
    color: #1e6f9f;
    background: #eef5fc;
    transform: scale(1.1);
}

.action-tooltip {
    position: absolute;
    bottom: -32px;
    left: 50%;
    transform: translateX(-50%) translateY(5px);
    background: #1f3e4b;
    color: white;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.7rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.1s ease;
    z-index: 10;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.action-tooltip::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-bottom: 5px solid #1f3e4b;
}

.action-item:hover .action-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
}

.course-info {
    padding: 1rem 1.2rem 1.2rem;
    text-align: center;
}

.course-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1f3e4b;
    margin: 0 0 0.25rem 0;
}

.course-code {
    font-size: 0.75rem;
    color: #8ba5bc;
    margin: 0;
}

@media (max-width: 768px) {
    .content-header {
        margin: 1rem 1rem 0 1rem;
    }

    .archive-btn,
    .courses-btn {
        padding: 0.5rem 1.2rem;
        font-size: 0.85rem;
    }

    .courses-grid {
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
        padding: 1rem;
    }

    .course-image {
        height: 130px;
    }

    .course-actions {
        padding: 0.8rem;
        gap: 0.5rem;
    }

    .action-item i {
        font-size: 1rem;
        padding: 6px;
    }

    .course-title {
        font-size: 0.95rem;
    }

    .action-tooltip {
        bottom: -28px;
        padding: 3px 8px;
        font-size: 0.65rem;
    }
}
