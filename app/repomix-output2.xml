        $validator = Validator::make($request->all(), [
            'text' => 'required|string|max:255',
            'image_url' => 'nullable|string|max:255',
        ]);

        if ($validator->fails()) {
            return response()->json(['errors' => $validator->errors(),'success' => false],  422);
