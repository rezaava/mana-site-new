            return response()->json(['errors' => $validator->errors(),'success' => false],  422);
        }

        

        $image = new Images();

        $image->type = 1; //فرضذ تایپ 1 برای پروژه ها هست
        $image->url = $request->input('url');
        $image->sub_id = $projectId;

        $image->save();

        return redirect()->back()->with('success', true);
