        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
      }
      .comment-item .cbody .reply-btn:hover {
        gap: 10px;
      }

      /* ===== فرم نظر ===== */
      .comment-form {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 32px;
        margin-top: 40px;
      }
      .comment-form textarea {
        width: 100%;
        background: var(--bg-soft);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 16px 20px;
        color: var(--text);
        font-family: inherit;
        font-size: 0.92rem;
        min-height: 110px;
        resize: vertical;
        transition: 0.3s;
      }
      .comment-form textarea:focus {
        outline: none;
        border-color: var(--accent-2);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-2) 15%, transparent);
      }
      .comment-form input {
        width: 100%;
        background: var(--bg-soft);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 14px 18px;
        color: var(--text);
        font-family: inherit;
        font-size: 0.92rem;
        margin-bottom: 14px;
        transition: 0.3s;
      }
      .comment-form input:focus {
        outline: none;
        border-color: var(--accent-2);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-2) 15%, transparent);
      }
      .comment-form .btn-flow {
        border: none;
        width: 100%;
        justify-content: center;
      }

      /* ===== سایدبار ===== */
      .sidebar-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 28px;
        margin-bottom: 28px;
        transition: all 0.4s var(--ease);
        box-shadow: var(--shadow-strong);
      }
      .sidebar-card:hover {
        border-color: color-mix(in srgb, var(--accent-2) 30%, transparent);
        transform: translateY(-4px);
      }
      .sidebar-card h5 {
        font-weight: 700;
        margin-bottom: 20px;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .sidebar-card h5 i {
        color: var(--accent-2);
      }
      .sidebar-card h5::after {
        content: "";
        flex: 1;
        height: 2px;
        background: linear-gradient(to left, var(--line), transparent);
        margin-right: 12px;
      }

      .related-item {
        display: flex;
        gap: 14px;
        padding-bottom: 18px;
