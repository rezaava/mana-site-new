}
.footer-col ul li a:hover {
  color: var(--accent-2);
  gap: 12px;
}
.footer-col ul li a i {
  font-size: 0.6rem;
}
.footer-center {
  text-align: center;
}
.footer-brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: 1.6rem;
  font-weight: 800;
  margin-bottom: 16px;
}
.footer-tag {
  color: var(--text-dim);
