/* Order Header Styling */
.order-header {
    background: linear-gradient(135deg, #3498db, #2980b9);
    color: white;
    border-radius: 15px;
    padding: 30px;
    margin-bottom: 30px;
    box-shadow: 0 10px 20px rgba(52, 152, 219, 0.2);
}

/* Product card styling */
.cart-card {
    border: none;
    border-radius: 15px;
    background: #fff;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.02);
}

.cart-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
}

/* Product image styling */
.product-img {
    height: 180px;
    object-fit: cover;
    width: 100%;
    transition: transform 0.5s ease;
}

.cart-card:hover .product-img {
    transform: scale(1.05);
}

/* Price tag styling */
.price-tag {
    font-weight: 800;
    font-size: 1.2rem;
}

/* Summary card styling */
.summary-card {
    background: #fff;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.02);
}

/* Quantity display styling */
.quantity-display {
    background-color: #f8f9fa;
    width: 45px;
    height: 45px;
    line-height: 45px;
    text-align: center;
    border-radius: 12px;
    font-weight: bold;
    color: #555;
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.05);
}

/* Custom Button */
.btn-reorder {
    background-color: #f8f9fa;
    color: #333;
    border: 1px solid #ddd;
    border-radius: 10px;
    font-size: 0.85rem;
    transition: all 0.2s;
}

.sticky-top {
    top: 100px;
}

.description-clamp {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    /* تعداد خطوطی که می‌خوای */
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
}
