}

.search-section {
    margin: 0.5rem 1.5rem 1.5rem 1.5rem;
}

.search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.search-icon {
    position: absolute;
    right: 16px;
    color: #a0bccd;
