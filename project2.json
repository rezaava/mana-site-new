class RedirectIfAuthenticatedCustom
{
    public function handle(Request $request, Closure $next)
    {
        // اگر کاربر لاگین است اجازه ورود به صفحه لاگین را نمی‌دهیم
        if (Auth::check() && Auth::user()->hasRole('student')) {
