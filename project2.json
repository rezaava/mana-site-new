### `public/style/client/profile_edit.css`

```css
/* استایل کارت پروفایل با گرادینت و انیمیشن */
.profile-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 24px;
    padding: 60px 20px;
    margin-bottom: 50px;
    box-shadow: 0 20px 40px rgba(79, 172, 254, 0.3);
    text-align: center;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease;
}

/* اشکال تزئینی پشت هدر */
.profile-header::before {
    content: '';
    position: absolute;
    top: -100px;
    right: -100px;
    width: 300px;
    height: 300px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    z-index: 0;
}

.profile-header::after {
    content: '';
    position: absolute;
    bottom: -50px;
    left: -50px;
    width: 200px;
    height: 200px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    z-index: 0;
}

/* استایل آواتار */
.avatar-img {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    border: 6px solid rgba(255, 255, 255, 0.3);
    object-fit: cover;
    margin-bottom: 20px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    z-index: 1;
}

.avatar-img:hover {
    transform: scale(1.1) rotate(5deg);
    border-color: rgba(255, 255, 255, 0.6);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
}

/* کارت فرم اصلی */
.info-card {
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.8);
    padding: 40px;
    position: relative;
    z-index: 2;
}

/* لیبل‌ها */
.form-label {
    font-weight: 700;
    color: #555;
    margin-bottom: 8px;
    font-size: 0.95rem;
}

/* گروه ورودی‌ها */
.input-group {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
}

.input-group:focus-within {
    box-shadow: 0 5px 15px rgba(79, 172, 254, 0.2);
    transform: translateY(-2px);
}

/* آیکون داخل اینپوت */
.input-group-text {
    background-color: #f8f9fa;
    border: 1px solid #eef2f7;
    border-right: none;
    color: #4facfe;
    font-weight: bold;
    padding: 12px 15px;
}

/* استایل اینپوت و سلکت */
.form-control,
.form-select {
    border: 1px solid #eef2f7;
    padding: 12px 15px;
    border-radius: 12px;
    background-color: #fcfcfc;
    font-family: 'Vazirmatn', sans-serif;
    transition: all 0.3s ease;
}

.form-control:focus,
.form-select:focus {
    box-shadow: none;
    border-color: #4facfe;
    background-color: #fff;
}

/* اصلاح گوشه‌ها برای اینپوت گروپ */
.input-group .form-control,
.input-group .form-select {
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
    border-left: none;
}

.input-group .input-group-text {
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* آیکون‌های SVG */
.input-group-text svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
}

/* دکمه ذخیره */
.btn-save {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 14px 50px;
    width: 100%;
    border-radius: 50px;
    font-weight: bold;
    font-size: 1rem;
    border: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 20px rgba(79, 172, 254, 0.3);
    position: relative;
    overflow: hidden;
    z-index: 1;
}

.btn-save::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
    z-index: -1;
    transition: opacity 0.3s ease;
    opacity: 0;
}

.btn-save:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 30px rgba(79, 172, 254, 0.4);
    color: white;
}

.btn-save:hover::before {
    opacity: 1;
}

/* دکمه انصراف */
.btn-cancel {
    border: 2px solid #eef2f7;
    color: #888;
    transition: all 0.3s ease;
}

.btn-cancel:hover {
    border-color: #ff6b6b;
    color: #ff6b6b;
    background-color: #fff5f5;
}

/* استایل لیبل آواتار برای اینکه کلیک‌پذیر باشد */
.avatar-label {
    cursor: pointer;
    display: inline-block;
}

/* استایل آیکون دوربین */
.camera-icon {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.5);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid white;
    transition: all 0.3s ease;
    z-index: 2;
}

/* افکت هاور روی آیکون دوربین */
.avatar-label:hover .camera-icon {
    background: #667eea;
    transform: scale(1.1);
}

/* افکت هاور روی عکس آواتار */
.avatar-label:hover .avatar-img {
    opacity: 0.9;
}
```

