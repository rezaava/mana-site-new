    transform: translateX(-3px);
}

.active-menu {
    background: #2c7cb6;
    color: white;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.menu-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
    margin: 12px 0;
}

.main-content {
    flex: 1;
    background: #f4f7fc;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
}

.logo-area {
    display: flex;
    align-items: center;
    gap: 8px;
}

.logo-link {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
}

.logo-icon {
    background: #1e6f9f;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: white;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.logo-text {
    font-size: 1.2rem;
    font-weight: 700;
    background: linear-gradient(135deg, #0b3b5f, #1c6e9e);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
}

.top-actions {
    display: flex;
    gap: 12px;
    align-items: center;
}

.profile-btn {
    background: none;
    border: none;
    padding: 0;
    transition: 0.2s;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    overflow: hidden;
    display: block;
}

.profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid #1e6f9f;
}

.profile-btn:hover {
    transform: scale(1.05);
    opacity: 0.9;
}

.top-icon-btn {
    background: #f0f4f9;
    padding: 8px 12px;
    border-radius: 40px;
    transition: 0.2s;
    color: #1f4e7a;
    font-size: 1.1rem;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.top-icon-btn i {
    margin: 0;
    font-size: 1.2rem;
}

.top-icon-btn:hover {
    background: #e2e9f2;
    transform: translateY(-2px);
}

.empty-content {
    flex: 1;
    background: #f4f7fc;
}

footer {
    text-align: center;
    padding: 1rem;
    font-size: 0.75rem;
    color: #5f7f9c;
}

.sidebar-right::-webkit-scrollbar {
    width: 4px;
}

.sidebar-right::-webkit-scrollbar-track {
    background: #1a4d6e;
}

.sidebar-right::-webkit-scrollbar-thumb {
    background: #2c7cb6;
    border-radius: 4px;
}

@media (max-width: 768px) {
    .sidebar-right {
        position: fixed;
        right: -220px;
        height: 100vh;
        top: 0;
        transition: 0.3s;
        z-index: 1050;
        width: 220px;
    }

    .sidebar-right.show-mobile {
        right: 0;
    }

    .dashboard-wrapper {
        flex-direction: column;
    }

    .main-content {
        width: 100%;
    }

    .top-header {
        padding: 0.6rem 1rem;
    }

    .menu-toggle-mobile {
        display: block;
        background: #1e6f9f;
        border: none;
        color: white;
        border-radius: 30px;
        padding: 6px 12px;
        margin-right: 10px;
    }

    .header-spacer {
        height: 70px;
    }
}

@media (min-width: 769px) {
    .menu-toggle-mobile {
        display: none;
    }
}
```

### `public/css/style-publics.css`

```css
.content-header {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin: 1.5rem 1.5rem 0 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #e0e9f0;
}

.add-course-btn {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: #1e6f9f;
    transition: all 0.3s ease;
    cursor: pointer;
}

.add-course-btn i {
    font-size: 2.5rem;
    color: #1e6f9f;
    transition: all 0.3s ease;
}

.add-course-btn:hover i {
    transform: scale(1.2) rotate(90deg);
    color: #0b4a6e;
}

.add-tooltip {
    font-size: 0.7rem;
    color: #5f7f9c;
    font-weight: 500;
    opacity: 0;
    transform: translateY(-5px);
    transition: all 0.3s ease;
}

.add-course-btn:hover .add-tooltip {
    opacity: 1;
    transform: translateY(0);
}

.courses-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem;
    padding: 1.8rem;
}

.course-card-wrapper {
    position: relative;
}

.course-card {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    text-decoration: none;
    display: block;
    cursor: pointer;
}

.course-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
}

.course-image {
    position: relative;
    width: 100%;
    height: 180px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: transform 0.4s ease;
}

.course-card:hover .course-image {
    transform: scale(1.05);
}

.course-info {
    padding: 1rem 1.2rem 1.2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
}

.course-title {
    font-size: 1rem;
    font-weight: 700;
    color: #1f3e4b;
    margin: 0;
}

.view-btn {
    display: inline-block;
    padding: 0.4rem 1.5rem;
    background: linear-gradient(135deg, #1e6f9f, #0b4a6e);
    color: white;
    border-radius: 30px;
    font-size: 0.75rem;
    font-weight: 600;
    transition: all 0.3s ease;
    text-decoration: none;
}

.course-card:hover .view-btn {
    background: linear-gradient(135deg, #0b4a6e, #1e6f9f);
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(30, 111, 159, 0.3);
}

@media (max-width: 1200px) {
    .courses-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 992px) {
    .courses-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .content-header {
        margin: 1rem 1rem 0 1rem;
        justify-content: center;
    }

    .add-course-btn i {
        font-size: 2rem;
    }

    .courses-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        padding: 1rem;
    }

    .course-image {
        height: 140px;
    }

    .course-title {
        font-size: 0.9rem;
    }

    .view-btn {
        padding: 0.3rem 1.2rem;
        font-size: 0.7rem;
    }
}

@media (max-width: 576px) {
    .courses-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
        padding: 1rem;
    }

    .course-image {
        height: 160px;
    }
}
