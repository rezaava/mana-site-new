        },
        x: {
          grid: { display: false },
          ticks: { color: textColor, font: { family: "Vazirmatn", size: 10 } },
        },
      },
    },
  });

  const ctx2 = genderCanvas.getContext("2d");
  genderChartInstance = new Chart(ctx2, {
    type: "doughnut",
    data: {
      labels: ["مرد", "زن"],
