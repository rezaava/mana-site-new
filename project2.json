    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
}

.ticket-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

.ticket-status {
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 20px;
}

.status-open {
    background: #e7f8ee;
    color: #1a7f4b;
}

.status-wait {
    background: #fff3cd;
    color: #856404;
}

.status-close {
    background: #f8d7da;
    color: #842029;
}

.ticket-title {
    font-weight: 600;
    font-size: 16px;
}

.ticket-date {
    font-size: 13px;
    color: #777;
}

.ticket-arrow {
    font-size: 20px;
    color: #bbb;
}

.ticket-chat {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
    overflow: hidden;
}

/* header */

.ticket-header {
    padding: 18px 25px;
    border-bottom: 1px solid #eee;
    background: #fafafa;
    font-weight: 600;
}

/* messages */

.ticket-messages {
    height: 60vh;
    overflow-y: auto;
    padding: 25px;
    background: #f6f8fb;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

/* rows */

.msg-row {
    display: flex;
}

/* admin message */

.msg-admin {
    justify-content: flex-end;
}

/* user message */

.msg-user {
    justify-content: flex-start;
}

/* bubble */

.msg {
    padding: 12px 16px;
    border-radius: 14px;
    font-size: 14px;
    line-height: 1.8;
    max-width: 65%;
    width: fit-content;
}

/* admin bubble */

.msg-admin .msg {
    background: #fff;
    border: 1px solid #eee;
    border-bottom-left-radius: 4px;
}

/* user bubble */

.msg-user .msg {
    background: #0d6efd;
    color: #fff;
    border-bottom-right-radius: 4px;
}

/* time */

.msg-time {
    font-size: 11px;
    margin-top: 6px;
    opacity: .7;
}


/* send box */

.ticket-send {
    padding: 18px;
    border-top: 1px solid #eee;
    background: #fff;
}

/* input group */

.ticket-send .input-group {
    gap: 10px;
}

/* input */

.ticket-send input {
    border-radius: 30px !important;
    padding: 10px 18px;
}

/* button */

.ticket-send button {
    border-radius: 30px !important;
    padding: 10px 22px;
}

/* info */
.ticket-row {
    width: 100%;
}

.ticket-info {
    width: 65%;
    overflow: hidden;
}

.ticket-status-box {
    width: 35%;
    justify-content: flex-end;
}

.ticket-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
```

