### `public/css/style-layout.css`

```css
* {
    font-family: 'Vazir', 'Inter', system-ui, 'Segoe UI', Tahoma, sans-serif;
}

body {
    background: #eef2f8;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

.top-header {
    background: white;
    padding: 0.6rem 1.5rem;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #e0e9f0;
    width: 100%;
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 1000;
    height: 70px;
}

.header-spacer {
    height: 70px;
}

.dashboard-wrapper {
    display: flex;
    min-height: calc(100vh - 70px);
}

.sidebar-right {
    width: 220px;
    background: linear-gradient(145deg, #0b2b44 0%, #0a3b5c 100%);
    color: white;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s;
    z-index: 99;
    flex-shrink: 0;
    height: calc(100vh - 70px);
    position: sticky;
    top: 70px;
    overflow-y: auto;
}

.sidebar-menu {
    padding: 1rem 0.5rem;
}

.menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    margin: 4px 0;
    border-radius: 12px;
    color: #eef4ff;
    font-weight: 500;
    font-size: 0.85rem;
    transition: 0.2s;
}

.menu-item i {
