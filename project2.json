  .gal-grid {
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .svc-grid {
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pinfo-grid {
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
