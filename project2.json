    position: relative;
}

/* آپلودر عکس پیشرفته */
.avatar-upload-wrapper {
    position: relative;
    width: 140px;
    height: 140px;
    margin: -70px auto 20px;
    /* بالا آمدن از هدر */
    border-radius: 50%;
    background: white;
    padding: 5px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    z-index: 10;
}

.avatar-preview {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background-color: #f0f2f5;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 3px solid transparent;
}

.avatar-preview:hover {
    filter: brightness(0.9);
}

.avatar-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    opacity: 0;
    transition: opacity 0.3s ease;
    cursor: pointer;
    font-size: 2rem;
}

.avatar-upload-wrapper:hover .avatar-overlay {
    opacity: 1;
}

/* استایل اینپوت‌ها */
.form-floating>.form-control {
    border-radius: 12px;
    border: 1px solid #e0e0e0;
    padding: 1rem 1rem;
    background-color: #f8f9fa;
    transition: all 0.3s;
}

.form-floating>.form-control:focus {
    background-color: #fff;
    border-color: #667eea;
    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
}

.form-floating>label {
    padding: 1rem 1rem;
    color: #6c757d;
}

/* دکمه‌ها */
.btn-modern {
    border-radius: 12px;
    padding: 12px 30px;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
}

.btn-primary-gradient {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: none;
    color: white;
    box-shadow: 0 4px 15px rgba(118, 75, 162, 0.3);
}

.btn-primary-gradient:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(118, 75, 162, 0.4);
    color: white;
}

.btn-outline-modern {
    border-radius: 12px;
    border: 2px solid #e0e0e0;
    color: #6c757d;
}

.btn-outline-modern:hover {
    background-color: #f8f9fa;
    border-color: #ced4da;
}

.custom-checkbox-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    /* اطمینان از پر شدن کل عرض */
}

.custom-checkbox {
    display: none;
}

.custom-checkbox-label {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    font-size: 0.9rem;
    color: #495057;
    user-select: none;
    flex-grow: 1;
    /* باعث می‌شود دکمه‌ها فضا را پر کنند */
