}

.register-btn {
    background: #dcfce7;
    color: #16a34a;
}

.register-btn:hover {
    background: #16a34a;
    color: white;
    transform: scale(1.05);
}

.questions-btn {
    background: #fef3c7;
    color: #d97706;
}

.questions-btn:hover {
    background: #d97706;
    color: white;
    transform: scale(1.05);
}

.bank-btn {
    background: #f3e8ff;
    color: #7c3aed;
}

.bank-btn:hover {
    background: #7c3aed;
    color: white;
    transform: scale(1.05);
}

@media (max-width: 768px) {
    .content-header {
        margin: 1rem 1rem 0 1rem;
