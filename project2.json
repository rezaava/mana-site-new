          "دوشنبه",
          "سه‌شنبه",
          "چهارشنبه",
          "پنج‌شنبه",
          "جمعه",
        ],
        year: ["۱۳۹۹", "۱۴۰۰", "۱۴۰۱", "۱۴۰۲", "۱۴۰۳", "۱۴۰۴", "۱۴۰۵"],
      };
      if (visitsChartInstance) {
        visitsChartInstance.data.labels = labelsMap[period] || labelsMap.month;
        visitsChartInstance.data.datasets[0].data =
          dataMap[period] || dataMap.month;
