/* استایل اختصاصی برای رادیو جنسیت */
.gender-radio {
    display: none;
}

.gender-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 0;
    /* افزایش ارتفاع برای زیبایی */
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    font-weight: 500;
    width: 100%;
    /* پر کردن کل عرض والد */
    height: 100%;
}

.gender-radio:checked+.gender-label {
    background-color: #0d6efd;
    color: white;
    border-color: #0d6efd;
}

/* ریسپانسیو */
@media (max-width: 768px) {
    .card-header-custom {
        padding: 40px 20px 80px;
        /* فضای بیشتر برای آواتار در موبایل */
    }

    .avatar-upload-wrapper {
        width: 120px;
        height: 120px;
        margin: -60px auto 15px;
    }
}
