    font-size: 0.78rem;
    padding: 8px 13px;
  }
  .gal-grid {
    grid-template-columns: 1fr;
  }
  .svc-grid {
    grid-template-columns: 1fr;
  }
  .pinfo-grid {
    grid-template-columns: 1fr 1fr;
  }
  .tech-pill {
    padding: 12px 18px;
