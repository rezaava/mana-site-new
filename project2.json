}

.text-truncate-2-lines {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    /* تعداد خطوط را اینجا مشخص کنید */
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.5;
    /* ارتفاع هر خط (اختیاری) */
    max-height: 3em;
    /* حداکثر ارتفاع (۲ خط ضربدر ۱.۵) */
