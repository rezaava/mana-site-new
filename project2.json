    transition: .2s
}

.info-item:hover {
    background: #fafafa;
    border-color: #e5e5e5
}

.info-label {
    font-weight: 600;
    color: #666;
    font-size: 14px
}

.info-value {
    font-weight: 600;
    color: #222;
    font-size: 14px
}

.bio {
    flex-direction: column;
    align-items: flex-start
}

.bio .info-value {
    font-weight: 500;
    color: #555;
    margin-top: 4px;
    background: #fafafa;
    padding: 8px 10px;
    border-radius: 6px
}

.tag-list {
    display: flex;
    gap: 6px;
    flex-wrap: wrap
}

.tag-item {
    background: #f4f6f8;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
    color: #555;
    transition: .2s
}

.tag-item:hover {
    background: #e9edf2
}

/* avatar */
.avatar-box {
    width: 120px;
    height: 120px;
    margin: auto;
    position: relative;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(135deg, #4facfe, #00f2fe)
}

.avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    position: relative
}

.avatar-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: .3s
}

.avatar-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, .45);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 20px;
    opacity: 0;
    cursor: pointer;
    transition: .3s
}

.avatar-inner:hover img {
    transform: scale(1.08)
}

.avatar-inner:hover .avatar-overlay {
    opacity: 1
}
