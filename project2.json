        }
        .sidebar .brand {
          font-size: 1rem;
          padding: 0 8px 16px;
        }
        .sidebar .nav-item {
          padding: 10px 14px;
          font-size: 0.84rem;
        }
        .sidebar .sub-menu .nav-item {
          padding: 7px 14px;
          font-size: 0.78rem;
        }
        .sidebar .user-card {
          padding: 12px 14px;
        }
      }

      @media (max-width: 400px) {
        .topbar .left .toggle-btn {
          width: 36px;
          height: 36px;
          font-size: 0.85rem;
        }
        .topbar .right .notif-btn {
          width: 36px;
          height: 36px;
          font-size: 0.85rem;
        }
        .topbar .right .theme-switch {
          width: 44px;
          height: 26px;
        }
        .topbar .right .theme-switch .knob {
          width: 18px;
          height: 18px;
          font-size: 0.5rem;
          top: 2px;
          right: 2px;
        }
        [data-theme="light"] .topbar .right .theme-switch .knob {
          transform: translateX(-18px);
        }
      }
